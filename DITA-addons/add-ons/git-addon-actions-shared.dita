<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-shared">
  <title>Actions</title>
  <shortdesc>Some Git Client actions are available in more than one view or menu. This table lists
    those actions and shows where each one is accessible.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>shared actions</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <section id="section_shared_sync_actions">
      <title>Synchronization Actions</title><p><table frame="all" rowsep="1" colsep="1"
          id="table_shared_sync_actions">
          <title>Synchronization actions</title>
          <tgroup cols="6">
            <colspec colname="c1" colwidth="2*"/>
            <colspec colname="c2" colwidth="3*"/>
            <colspec colname="c3" colwidth="1*"/>
            <colspec colname="c4" colwidth="1*"/>
            <colspec colname="c5" colwidth="1*"/>
            <colspec colname="newCol6" colwidth="1*"/>
            <thead>
              <row>
                <entry>Action</entry>
                <entry>Description</entry>
                <entry>Git Staging</entry>
                <entry>Git Branch Manager</entry>
                <entry>Git History</entry>
                <entry>Git Menu</entry>
              </row>
            </thead>
            <tbody>
              <row>
                <entry><xref
                    href="git-addon-actions-synchronize-conflicts.dita#git-addon-actions-synchronize-conflicts/action_push"
                      ><uicontrol>Push</uicontrol></xref></entry>
                <entry>Sends local commits from the current branch to the remote repository.</entry>
                <entry>✓</entry>
                <entry>✓</entry>
                <entry>✓</entry>
                <entry>✓</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-synchronize-conflicts.dita#git-addon-actions-synchronize-conflicts/action_pull_merge"
                      ><uicontrol>Pull (merge)</uicontrol></xref></entry>
                <entry>Pulls the latest changes from the remote repository and merges them into the
                  local branch.</entry>
                <entry>✓</entry>
                <entry>✓</entry>
                <entry>✓</entry>
                <entry>✓</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-synchronize-conflicts.dita#git-addon-actions-synchronize-conflicts/action_pull_rebase"
                      ><uicontrol>Pull (rebase)</uicontrol></xref></entry>
                <entry>Pulls the latest changes and reapplies local unpublished commits on top of
                  the updated branch.</entry>
                <entry>✓</entry>
                <entry>✓</entry>
                <entry>✓</entry>
                <entry>✓</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-synchronize-conflicts.dita#git-addon-actions-synchronize-conflicts/action_pull_other_branch"
                      ><uicontrol>Pull...</uicontrol></xref></entry>
                <entry>Pulls changes from a remote branch other than the tracked branch.</entry>
                <entry>✓</entry>
                <entry/>
                <entry/>
                <entry>✓</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-synchronize-conflicts.dita#git-addon-actions-synchronize-conflicts/action_fetch"
                      ><uicontrol>Fetch</uicontrol></xref></entry>
                <entry>Downloads the latest commits and remote-tracking references from all
                  configured remotes without modifying the working copy.</entry>
                <entry>✓</entry>
                <entry>✓</entry>
                <entry/>
                <entry>✓ </entry>
              </row>
            </tbody>
          </tgroup>
        </table></p></section>
    <section id="section_shared_branch_actions">
      <title>Branch Actions</title><p><table frame="all" rowsep="1" colsep="1"
          id="table_shared_branch_actions">
          <title>Branch actions</title>
          <tgroup cols="4">
            <colspec colname="c1" colwidth="2*"/>
            <colspec colname="c2" colwidth="3*"/>
            <colspec colname="c3" colwidth="1*"/>
            <colspec colname="c4" colwidth="1*"/>
            <thead>
              <row>
                <entry>Action</entry>
                <entry>Description</entry>
                <entry>Git Branch Manager</entry>
                <entry>Git History</entry>
              </row>
            </thead>
            <tbody>
              <row>
                <entry><xref
                    href="git-addon-actions-branches-history.dita#git-addon-actions-branches-history/action_checkout"
                      ><uicontrol>Checkout</uicontrol></xref></entry>
                <entry>Switches the repository to the selected branch, tag, or commit. See <xref
                    href="git-addon-check-out-a-branch.dita#git-addon-check-out-a-branch"/>.</entry>
                <entry>✓</entry>
                <entry>✓</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-branches-history.dita#git-addon-actions-branches-history/action_create_branch"
                      ><uicontrol>Create Branch</uicontrol></xref></entry>
                <entry>Creates a branch from the selected branch or commit.</entry>
                <entry>✓</entry>
                <entry>✓</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-branches-history.dita#git-addon-actions-branches-history/action_merge_branch_or_commit"
                      ><uicontrol>Merge</uicontrol></xref></entry>
                <entry>Merges the selected branch or commit into the current branch.</entry>
                <entry>✓</entry>
                <entry>✓</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-branches-history.dita#git-addon-actions-branches-history/action_track_remote_branch"
                      ><uicontrol>Track Remote Branch</uicontrol></xref></entry>
                <entry>Sets the remote branch that the local branch tracks for fetch, push, and
                  pull.</entry>
                <entry>✓</entry>
                <entry/>
              </row>
            </tbody>
          </tgroup>
        </table></p><p>Track Remote Branch is also available in the <xref
          href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
        menu</xref>.</p></section>
    <section id="section_shared_view_actions"><title>View and Navigation Actions</title><p>To
        access, go to <menucascade>
          <uicontrol>Git Staging</uicontrol>
          <uicontrol><image href="../img/Ellipsis18.png" id="image_nnl_3dn_pjc"
            />Ellipsis</uicontrol>
        </menucascade>  or the <uicontrol>Git</uicontrol> menu:</p><p><table frame="all" rowsep="1"
          colsep="1" id="table_shared_view_actions">
          <title>View and navigation actions</title>
          <tgroup cols="2">
            <colspec colname="c1" colwidth="2*"/>
            <colspec colname="c2" colwidth="3*"/>
            <thead>
              <row>
                <entry>Action</entry>
                <entry>Description</entry>
              </row>
            </thead>
            <tbody>
              <row>
                <entry><xref
                    href="git-addon-actions-branches-history.dita#git-addon-actions-branches-history/action_show_branches"
                      ><uicontrol>Show Branches</uicontrol></xref></entry>
                <entry>Opens the <uicontrol>Git Branch Manager</uicontrol> view.</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-branches-history.dita#git-addon-actions-branches-history/action_show_history"
                      ><uicontrol>Show History</uicontrol></xref></entry>
                <entry>Opens the <uicontrol>Git History</uicontrol> view for the current repository,
                  selected resource, or current file.</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-branches-history.dita#git-addon-actions-branches-history/action_show_tags"
                      ><uicontrol>Show Tags</uicontrol></xref></entry>
                <entry>Opens the tag management dialog box.</entry>
              </row>
            </tbody>
          </tgroup>
        </table></p></section>
    <section id="section_shared_config_actions"><title>Configuration Actions</title><p>To access, go
        to <menucascade>
          <uicontrol>Git Staging</uicontrol>
          <uicontrol><image href="../img/Ellipsis18.png" id="image_vy4_mfn_pjc"
            />Ellipsis</uicontrol>
        </menucascade>  or the <uicontrol>Git</uicontrol> menu:</p><p><table frame="all" rowsep="1"
          colsep="1" id="table_shared_config_actions">
          <title>Configuration actions</title>
          <tgroup cols="2">
            <colspec colname="c1" colwidth="2*"/>
            <colspec colname="c2" colwidth="4*"/>
            <thead>
              <row>
                <entry>Action</entry>
                <entry>Description</entry>
              </row>
            </thead>
            <tbody>
              <row>
                <entry><xref
                    href="git-addon-actions-configuration.dita#git-addon-actions-configuration/action_manage_remote_repositories"
                      ><uicontrol>Manage Remote Repositories</uicontrol></xref></entry>
                <entry>Opens a dialog box where you can add, edit, or delete remote repositories for
                  the current working copy.</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-configuration.dita#git-addon-actions-configuration/action_edit_repository_config_file"
                      ><uicontrol>Edit Repository Config File</uicontrol></xref></entry>
                <entry>Opens the repository <codeph>config</codeph> file in the main editor.</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-configuration.dita#git-addon-actions-configuration/action_preferences"
                      ><uicontrol>Preferences</uicontrol></xref></entry>
                <entry>Opens the <xref href="git-addon-preferences.dita#git-addon-preferences">Git
                    Client preferences page</xref>.</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-configuration.dita#git-addon-actions-configuration/action_reset_all_credentials"
                      ><uicontrol>Reset All Credentials</uicontrol></xref></entry>
                <entry>Removes stored credentials so the Git Client prompts for new ones on the next
                  authentication attempt.</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-advanced.dita#git-addon-actions-advanced/action_stash_changes"
                      ><uicontrol>Stash Changes</uicontrol></xref></entry>
                <entry>Creates a new stash from the changed files in the working copy and removes
                  them from the working copy.</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-advanced.dita#git-addon-actions-advanced/action_list_stashes"
                      ><uicontrol>List Stashes</uicontrol></xref></entry>
                <entry>Opens a dialog box that lists existing stashes for the current
                  repository.</entry>
              </row>
              <row>
                <entry><xref
                    href="git-addon-actions-advanced.dita#git-addon-actions-advanced/action_submodule"
                      ><uicontrol>Submodule</uicontrol></xref></entry>
                <entry>Opens a control where you can select a submodule to open. Enabled only when
                  the repository contains submodules.</entry>
              </row>
            </tbody>
          </tgroup>
        </table></p></section>
  </refbody>
</reference>
