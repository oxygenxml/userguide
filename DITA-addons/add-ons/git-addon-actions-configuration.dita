<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-configuration">
  <title>Configuration and Preferences Actions</title>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>configuration actions</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>preferences actions</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 4* 3*">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Accessible From</stentry>
      </sthead>
      <strow id="action_manage_remote_repositories">
        <stentry><uicontrol>Manage Remote Repositories</uicontrol></stentry>
        <stentry>Opens a dialog box where you can add, edit, or delete remote repositories for the
          current working copy. Use this action to update remote URLs, add another remote, or remove
          a remote that is no longer used.</stentry>
        <stentry>
          <ul>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_edit_repository_config_file">
        <stentry><uicontrol>Edit Repository Config File</uicontrol></stentry>
        <stentry>Opens the repository configuration file in the main editor. This file stores local
          Git settings such as remote URLs, branch tracking settings, and repository-specific
          options. Edit it only when you know which Git settings need to change — incorrect values
          can affect push, pull, and branch tracking behavior.</stentry>
        <stentry>
          <ul>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_preferences">
        <stentry><uicontrol>Preferences</uicontrol></stentry>
        <stentry>Opens the Git Client preferences page, where you can configure authentication,
          commit signing, and other Git Client options at the global or project level.</stentry>
        <stentry>
          <ul>
            <li><menucascade><uicontrol>Options</uicontrol><uicontrol>Preferences</uicontrol><uicontrol>Plugins</uicontrol><uicontrol>Git
                  Client</uicontrol></menucascade></li>
            <li><menucascade><uicontrol>Git</uicontrol><uicontrol>Settings</uicontrol><uicontrol>Preferences</uicontrol></menucascade></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Ellipsis</uicontrol> menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_reset_all_credentials">
        <stentry><uicontrol>Reset All Credentials</uicontrol></stentry>
        <stentry>Removes stored credentials so that the Git Client prompts you for new ones on the
          next authentication attempt. Use this when saved credentials are no longer valid or when
          access tokens have been rotated.</stentry>
        <stentry>
          <ul>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Ellipsis</uicontrol> menu</xref></li>
            <li><menucascade><uicontrol>Git</uicontrol><uicontrol>Settings</uicontrol><uicontrol>Reset
                  all credentials</uicontrol></menucascade></li>
          </ul>
        </stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
