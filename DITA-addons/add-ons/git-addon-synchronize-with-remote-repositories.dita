<concept id="git-addon-synchronize-with-remote-repositories">
  <title>Synchronize with Remote Repositories</title>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>synchronizing changes</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>push</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>pull</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <conbody>
    <p id="p_git_sync_remote_overview">Use this section when you need to exchange commits with a remote repository. After you review and commit local changes, push them to publish your work or pull remote changes into the current branch.</p>
  </conbody>
</concept>
