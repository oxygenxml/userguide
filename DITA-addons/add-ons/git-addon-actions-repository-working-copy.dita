<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-repository-working-copy">
  <title>Repository and Working Copy Actions</title>
  <shortdesc>The following table lists actions for opening, creating, and managing repositories and
    working copies.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>repository actions</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>working copy actions</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 4* 3*">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Accessible From</stentry>
      </sthead>
      <strow id="action_clone_repository">
        <stentry><uicontrol>Clone Repository</uicontrol></stentry>
        <stentry>Creates a local copy of a remote Git repository. You provide the remote URL,
          destination path, and optionally a branch to check out. After cloning, the new repository
          becomes the active working copy. See <xref
            href="git-addon-cloning-a-repository.dita#git-addon-cloning-a-repository"/>.</stentry>
        <stentry>
          <ul>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_open_repository_select_working_copy">
        <stentry><uicontrol>Open Repository</uicontrol></stentry>
        <stentry>Selects an existing local Git repository as the active working copy. The selected
          folder must already be a Git repository. See <xref
            href="git-addon-selecting-a-working-copy.dita#git-addon-selecting-a-working-copy"
          />.</stentry>
        <stentry>
          <ul>
            <li><uicontrol>Open repository...</uicontrol> in the <xref
                href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
            <li><uicontrol>Browse</uicontrol> button next to the <uicontrol>Working copy</uicontrol>
              combo box in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface"
                  ><uicontrol>Git Staging</uicontrol> view</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_create_repository_in_project">
        <stentry><uicontrol>Create Repository in Project</uicontrol></stentry>
        <stentry>Initializes a Git repository in the current <ph keyref="product"/> project folder.
          Enabled only when the project folder is not already part of a Git repository.</stentry>
        <stentry>
          <ul>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_create_repository_here">
        <stentry><uicontrol>Create Repository Here</uicontrol></stentry>
        <stentry>Initializes a Git repository in a selected folder from the
            <uicontrol>Project</uicontrol> view. Use this when only one folder in the project should
          become a Git repository. Available only when the selected folder is not already part of a
          Git repository.</stentry>
        <stentry><uicontrol>Git</uicontrol> submenu in the <xref
            href="git-actions-in-other-views-editors.dita#git-addon-project-view-dita-maps-manager-and-the-current-editor/section_git_contextual_actions_locations"
              ><uicontrol>Project</uicontrol> view context menu</xref></stentry>
      </strow>
      <strow id="action_show_working_copy_in_finder">
        <stentry><uicontrol>Show Working Copy in
            <?oxy_comment_start author="adrian_lapadat" timestamp="20260602T181032+0300" comment="add conditional profiling for Mac/Windows"?>Finder<?oxy_comment_end?></uicontrol></stentry>
        <stentry>Opens the current working copy folder in the operating system file
          browser.</stentry>
        <stentry>
          <ul>
            <li><menucascade><uicontrol>Git</uicontrol><uicontrol>Show working copy
                  in</uicontrol><uicontrol>Finder</uicontrol></menucascade></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_show_working_copy_in_terminal">
        <stentry><uicontrol>Show Working Copy in Terminal</uicontrol></stentry>
        <stentry>Opens a terminal in the current working copy folder so you can run Git or operating
          system commands from that location.</stentry>
        <stentry>
          <ul>
            <li><menucascade><uicontrol>Git</uicontrol><uicontrol>Show working copy
                  in</uicontrol><uicontrol>Terminal</uicontrol></menucascade></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
          </ul>
        </stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
