<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-branches-history">
  <title>Branch, Tag, History, and Blame Actions</title>
  <shortdesc>The following table lists actions for working with branches, tags, history, and blame
    information.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>branch actions</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>history actions</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>blame actions</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>rebase onto commit</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 4* 3*">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Accessible From</stentry>
      </sthead>
      <strow id="action_show_staging">
        <stentry><uicontrol>Show Staging</uicontrol></stentry>
        <stentry>Opens the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface"
              ><uicontrol>Git Staging</uicontrol> view</xref>, where you can review working copy
          changes, stage files, commit, push, and pull.</stentry>
        <stentry><xref href="git-addon-git-menu.dita#git-addon-git-menu"
              ><uicontrol>Git</uicontrol> menu</xref></stentry>
      </strow>
      <strow id="action_show_branches">
        <stentry><uicontrol>Show Branches</uicontrol> or <uicontrol>Show Git Branch Manager
            View</uicontrol></stentry>
        <stentry>Opens the <xref
            href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"><uicontrol>Git
              Branch Manager</uicontrol> view</xref>, where you inspect branch state, check out
          branches, create branches, merge branches, and configure remote branch tracking.</stentry>
        <stentry>
          <ul>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_view_toolbar"
                  ><uicontrol>Git Staging</uicontrol> view toolbar</xref></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_checkout">
        <stentry><uicontrol>Checkout</uicontrol></stentry>
        <stentry>Switches the local repository to the selected local branch, remote branch, tag, or
          commit. See <xref href="git-addon-check-out-a-branch.dita#git-addon-check-out-a-branch"
          />.</stentry>
        <stentry>
          <ul>
            <li>Contextual menu in the <xref
                href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager/section_git_branch_manager_local_branch_actions"
                  ><uicontrol>Git Branch Manager</uicontrol> view local branch actions</xref></li>
            <li>Contextual menu in the <xref
                href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history/section_git_history_table"
                  ><uicontrol>Git History</uicontrol> view history table</xref></li>
            <li>Tag management dialog box</li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_create_branch">
        <stentry><uicontrol>Create Branch</uicontrol></stentry>
        <stentry>Creates a branch from the selected branch or commit. Deselect
            <uicontrol>Checkout branch</uicontrol> in the <uicontrol>Create branch</uicontrol>
          dialog box if you only want to create the branch and keep working on the current
          branch.</stentry>
        <stentry>
          <ul>
            <li>Contextual menu in the <xref
                href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"
                  ><uicontrol>Git Branch Manager</uicontrol> view</xref></li>
            <li>Contextual menu in the <xref
                href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
                  ><uicontrol>Git History</uicontrol> view</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_track_remote_branch">
        <stentry><uicontrol>Track Remote Branch</uicontrol></stentry>
        <stentry>Lets you select the remote branch that the local branch tracks for fetch, push,
          and pull commands.</stentry>
        <stentry>
          <ul>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Ellipsis</uicontrol> menu</xref></li>
            <li>Local branch contextual menu in the <xref
                href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"
                  ><uicontrol>Git Branch Manager</uicontrol> view</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_merge_branch_or_commit">
        <stentry><uicontrol>Merge Selected Branch or Commit</uicontrol></stentry>
        <stentry>Merges the selected branch or commit into the current branch. If the histories
          diverged, Git may create a merge commit. If the same files changed in incompatible ways,
          conflicts must be resolved before the merge can finish. See <xref
            href="merging_changes.dita#merging_changes"/>.</stentry>
        <stentry>
          <ul>
            <li>Local branch contextual menu in the <xref
                href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"
                  ><uicontrol>Git Branch Manager</uicontrol> view</xref></li>
            <li>Commit contextual menu in the <xref
                href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
                  ><uicontrol>Git History</uicontrol> view</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_rebase_onto">
        <stentry><uicontrol>Rebase...</uicontrol></stentry>
        <stentry>Rebases the current branch's local commits onto the selected commit. A confirmation
          dialog box shows the current branch name before the operation starts. If conflicts occur,
          a warning dialog box lists the conflicting files and the repository enters a
          rebase-in-progress state. If the repository already has unresolved conflicts or if
          uncommitted changes would be overwritten, the rebase does not start. Because Git
            <codeph>rebase</codeph> rewrites local commit history, use it only for commits that have
          not been pushed to a shared remote branch. After rebasing, a force push is required to
          update the remote branch.</stentry>
        <stentry>Commit contextual menu in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history/section_git_history_table"
              ><uicontrol>Git History</uicontrol> view history table</xref>. Not available on the
            <uicontrol>Uncommitted changes</uicontrol> row.</stentry>
      </strow>
      <strow id="action_squash_merge_branch">
        <stentry><uicontrol>Squash Merge Selected Branch</uicontrol></stentry>
        <stentry>Merges changes from the selected branch since it diverged from the current branch
          and records the result in a new commit on the current branch.</stentry>
        <stentry>Local branch contextual menu in the <xref
            href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"><uicontrol>Git
              Branch Manager</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_show_in_history">
        <stentry><uicontrol>Show in History</uicontrol></stentry>
        <stentry>Selects the commit that corresponds to the <codeph>HEAD</codeph> of the selected
          branch in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref>.</stentry>
        <stentry>Local branch contextual menu in the <xref
            href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"><uicontrol>Git
              Branch Manager</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_delete_branch">
        <stentry><uicontrol>Delete Branch</uicontrol></stentry>
        <stentry>Deletes the selected local branch. Before deleting a branch, make sure its work
          was merged, pushed, or is no longer needed.</stentry>
        <stentry>Local branch contextual menu in the <xref
            href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"><uicontrol>Git
              Branch Manager</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_show_tags">
        <stentry><uicontrol>Show Tags</uicontrol></stentry>
        <stentry>Opens a dialog box that lists all tags in the current repository. From the tag
          list, you can delete tags, check out a specific tag, or push a local-only tag to the
          remote repository.</stentry>
        <stentry>
          <ul>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_create_tag">
        <stentry><uicontrol>Create Tag</uicontrol></stentry>
        <stentry>Creates a tag on the selected commit. Tags are useful for marking releases or
          other important points in history. A new tag is local until you push it to the remote
          repository. See <xref href="git-addon-creating-tags.dita#git-addon-creating-tags"/>.</stentry>
        <stentry>Commit contextual menu in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_show_history">
        <stentry><uicontrol>Show History</uicontrol> or <uicontrol>Show Current Repository
            History</uicontrol></stentry>
        <stentry>Opens the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref> for the current repository, selected
          resource, or current file.</stentry>
        <stentry>
          <ul>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_view_toolbar"
                  ><uicontrol>Git Staging</uicontrol> view toolbar</xref></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
                  ><uicontrol>Unstaged files</uicontrol> area</xref> contextual menu</li>
            <li>Contextual <uicontrol>Git</uicontrol> submenus in <xref
                href="git-addon-project-view-dita-maps-manager-and-the-current-editor.dita#git-addon-project-view-dita-maps-manager-and-the-current-editor/section_git_contextual_actions_locations"
                >supported views and editors</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_cherry_pick">
        <stentry><uicontrol>Cherry-Pick</uicontrol></stentry>
        <stentry>Applies the changes from the selected commit to the current branch by creating a
          new commit with that change. Conflicts can occur and the operation can be aborted if you
          do not want to resolve them.</stentry>
        <stentry>Commit contextual menu in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_revert_commit">
        <stentry><uicontrol>Revert Commit</uicontrol></stentry>
        <stentry>Creates a commit that reverses all changes from the selected commit. Revert is safe
          for commits that are already shared because it adds a new commit with opposite changes
          instead of rewriting the revision history.</stentry>
        <stentry>Commit contextual menu in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_reset_branch_to_commit">
        <stentry><uicontrol>Reset Branch to Commit</uicontrol></stentry>
        <stentry>Moves the <codeph>HEAD</codeph> of the current branch to the selected commit.
          Because reset can rewrite branch history, use it with care, especially on branches shared
          with other users.</stentry>
        <stentry>Commit contextual menu in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_explain_commit">
        <stentry><uicontrol>Explain Commit</uicontrol></stentry>
        <stentry>Uses AI Positron to explain the changes from the selected commits. See <xref
            href="git-addon-explaining-commits-with-ai.dita#git-addon-explaining-commits-with-ai"
          />.</stentry>
        <stentry>Commit contextual menu in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_open_previous_version">
        <stentry><uicontrol>Open Previous Version</uicontrol></stentry>
        <stentry>Opens the version of the selected resource from before its deletion so you can
          inspect removed content without restoring the file to the working copy.</stentry>
        <stentry><xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history/section_git_history_affected_resources"
              ><uicontrol>Affected resources</uicontrol> pane</xref> in the
            <uicontrol>Git History</uicontrol> view</stentry>
      </strow>
      <strow id="action_open_working_copy_version">
        <stentry><uicontrol>Open Working Copy Version</uicontrol></stentry>
        <stentry>Opens the working copy version of the selected resource so you can compare a
          historical resource entry with the file as it currently exists on disk.</stentry>
        <stentry>Affected resources pane in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_reset_file_to_this_commit">
        <stentry><uicontrol>Reset File to This Commit</uicontrol></stentry>
        <stentry>Performs a checkout of the selected version of the resource and overwrites its
          current working copy version.</stentry>
        <stentry>Affected resources pane in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_compare_with_previous_version">
        <stentry><uicontrol>Compare with Previous Version</uicontrol></stentry>
        <stentry>Compares the selected version of the resource with the previous version so you can
          review the difference introduced by a commit for one modified file.</stentry>
        <stentry>Affected resources pane in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_compare_with_working_copy_version">
        <stentry><uicontrol>Compare with Working Copy Version</uicontrol></stentry>
        <stentry>Compares the selected version of the resource with the current working copy
          version.</stentry>
        <stentry>Affected resources pane in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_compare_with_each_other">
        <stentry><uicontrol>Compare with Each Other</uicontrol></stentry>
        <stentry>Compares two selected versions of a single file with each other so you can see how
          the file changed between two points in history.</stentry>
        <stentry>Affected resources pane in the <xref
            href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
              ><uicontrol>Git History</uicontrol> view</xref></stentry>
      </strow>
      <strow id="action_show_blame">
        <stentry><uicontrol>Show Blame</uicontrol></stentry>
        <stentry>Opens the selected resource in the main editing area and colors editor lines based
          on revision information. See <xref href="git-addon-blame.dita#git-addon-blame"/>.</stentry>
        <stentry>
          <ul>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
                  ><uicontrol>Unstaged files</uicontrol> area</xref> contextual menu</li>
            <li><xref
                href="git-addon-project-view-dita-maps-manager-and-the-current-editor.dita#git-addon-project-view-dita-maps-manager-and-the-current-editor/section_git_contextual_actions_locations"
                >Current editor contextual menu</xref></li>
            <li><uicontrol>Git</uicontrol> submenu in the <xref
                href="git-addon-project-view-dita-maps-manager-and-the-current-editor.dita#git-addon-project-view-dita-maps-manager-and-the-current-editor/section_git_contextual_actions_locations"
                  ><uicontrol>Project</uicontrol> view</xref></li>
            <li><uicontrol>Git</uicontrol> submenu in the <xref
                href="git-addon-project-view-dita-maps-manager-and-the-current-editor.dita#git-addon-project-view-dita-maps-manager-and-the-current-editor/section_git_contextual_actions_locations"
                  ><uicontrol>DITA Maps Manager</uicontrol> view</xref></li>
          </ul>
        </stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
