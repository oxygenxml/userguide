<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="git-staging-uicontrols" >
    <title>git-staging-uicontrols</title>
  <!--TOOLBAR-->
    <body>
      <p><uicontrol id="gs0-git-staging-view">Git Staging</uicontrol></p>
    <p><uicontrol id="gs1-git-staging-push"><image href="../img/git-addon/icons/GitPush21.png"/>
        Push</uicontrol></p>
    <p><uicontrol id="gs2-git-staging-pull"><image href="../img/GitPullDrop16.png"
          id="image_lgh_2df_4jc"/> Pull</uicontrol></p>
    <p><uicontrol id="gs3-git-staging-stash"><image href="../img/Stash18.png" id="image_qp1_1mp_pjc"
        /> Stash</uicontrol></p>
    <p><uicontrol id="gs4-git-staging-open-history"><image href="../img/History18.png"
          id="image_egl_n4p_pjc"/> Show current repository history</uicontrol></p>
    <p><uicontrol id="gs5-git-staging-open-branch-manager"><image href="../img/Branch18.png"
          id="image_nsf_4tp_pjc"/> Show Git Branch Manager view</uicontrol></p>
      <p><uicontrol id="gs6-git-staging-ellipsis"><image href="../img/Ellipsis18.png"
          id="image_pcx_n4p_pjc"/> Ellipsis</uicontrol></p>
    <!--STAGING-->
    <!--area-->
    <p><uicontrol id="gs1-unstaged-files">Unstaged files</uicontrol>
    </p>
    <p><uicontrol>Staged files</uicontrol>
    </p>
    <!--controls-->
    <p><uicontrol><image href="../img/StageSelected18.png" id="image_vbv_n3j_43c" placement="inline"
        />Stage selected</uicontrol></p>
    <p><uicontrol><image href="../img/StageAll18.png" id="image_wbv_n3j_43c" placement="inline"
        />Stage all</uicontrol></p>
    <p><uicontrol><image href="../img/UnstageSelected18.png" id="image_brz_43j_43c"
          placement="inline"/>Unstage selected</uicontrol></p>
    <p><uicontrol><image href="../img/UnstageAll18.png" id="image_crz_43j_43c" placement="inline"
        />Unstage all</uicontrol></p>
    <!--Ignore-->
    <p><uicontrol id="ignore">Ignore</uicontrol></p>
    <p><uicontrol id="ignore-file">Ignore this file</uicontrol></p>
    <p><uicontrol id="ignore-parent-dir">Ignore parent directory</uicontrol></p>
    <p><uicontrol id="ignore-by-extension">Ignore by extension</uicontrol></p>
    <p><uicontrol id="open-gitignore">Open project .gitignore</uicontrol></p>
    <p><uicontrol id="open-ignore">Open global ignore file</uicontrol></p>
    <p><uicontrol id="ign-dir-0-ignore-dir">Ignore this directory</uicontrol></p>
    <p><uicontrol id="ign-dir-1-ignore-all-files">Ignore all files</uicontrol></p>
    <!--Conflict resolution 
    prefix: git-client-conflicts, conflicts = conflict resolution-->
    <!--in Unstaged files context menu-->
      <p><uicontrol id="git-client-conflicts-resolve-conflict">Resolve conflict</uicontrol><!--parent--></p>
    <!--children:-->
    <p><uicontrol id="git-client-conflicts-open-in-compare-editor">Open in compare editor</uicontrol></p>
    <p><uicontrol id="git-client-conflicts-resolve-with-ai">Resolve with AI</uicontrol></p>
      <p><uicontrol id="git-client-conflicts-resolve-using-mine">Resolve Using "Mine"</uicontrol></p>
      <p><uicontrol id="git-client-conflicts-resolve-using-theirs">Resolve Using "Theirs"</uicontrol></p>
      <p><uicontrol id="git-client-conflicts-mark-resolved">Mark Resolved</uicontrol></p>
    <!--on Compare editor window-->
    <p><uicontrol id="git-client-conflicts-ai-conflict-resolution">AI Conflict Resolution</uicontrol></p>
    <p><uicontrol id="git-client-conflicts-ai-analysis">AI Analysis</uicontrol></p>
    <!--Commit messages
    prefix: git-client-commit-msg, commit-msg = commit message(s)-->
    <p><uicontrol id="git-client-commit-msg-generate-commit-message-using-ai"><image href="../img/AI-Git16.png" placement="inline"/>Generate commit message using AI</uicontrol></p>
    </body>
</topic>
