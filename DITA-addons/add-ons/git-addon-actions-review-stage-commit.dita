<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-review-stage-commit">
  <title>Review, Compare, Stage, and Commit Actions</title>
  <shortdesc>The following table lists actions for reviewing changes, comparing resources, staging
    files, and creating commits.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>review actions</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>stage actions</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>commit actions</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 4* 3*">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Accessible From</stentry>
      </sthead>
      <strow id="action_open">
        <stentry><uicontrol>Open</uicontrol></stentry>
        <stentry>Opens the selected file, folder, or submodule so you can inspect it before deciding
          what to do with the change.</stentry>
        <stentry>
          <ul>
            <li>Contextual menu in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
                  ><uicontrol>Unstaged files</uicontrol> area</xref></li>
            <li>Contextual menu in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
                  ><uicontrol>Staged files</uicontrol> area</xref></li>
            <li><xref
                href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history/section_git_history_affected_resources"
                  ><uicontrol>Affected resources</uicontrol> pane</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_open_in_compare_editor">
        <stentry><uicontrol>Open in Compare Editor</uicontrol></stentry>
        <stentry>Opens a comparison for the selected changed file so you can review the exact edits
          before staging or committing it. See <xref
            href="git-addon-comparing-changes.dita#git-addon-comparing-changes"/>.</stentry>
        <stentry>
          <ul>
            <li>Contextual menu of a resource in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
                  ><uicontrol>Unstaged files</uicontrol> area</xref></li>
            <li>Double-click a changed resource in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
                  ><uicontrol>Unstaged files</uicontrol> area</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_git_diff">
        <stentry><uicontrol>Git Diff</uicontrol></stentry>
        <stentry>Compares the selected resource with its repository version so you can inspect local
          changes without going through the full staging workflow.</stentry>
        <stentry><uicontrol>Git</uicontrol> submenu in the <xref
            href="git-actions-in-other-views-editors.dita#git-actions-in-other-views-editors/section_git_contextual_actions_locations"
              ><uicontrol>Project</uicontrol> view context menu</xref></stentry>
      </strow>
      <strow id="action_stage">
        <stentry><uicontrol>Stage</uicontrol></stentry>
        <stentry>Moves the selected unstaged resources to the <uicontrol>Staged files</uicontrol>
          area. Stage only the files that belong in the next commit.</stentry>
        <stentry>Contextual menu of the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
              ><uicontrol>Unstaged files</uicontrol> area</xref></stentry>
      </strow>
      <strow id="action_stage_selected">
        <stentry><uicontrol>Stage Selected</uicontrol></stentry>
        <stentry>Moves the selected unstaged files to the <uicontrol>Staged files</uicontrol> area
          by using the staging controls between the file lists.</stentry>
        <stentry>Stage controls in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
              ><uicontrol>Git Staging</uicontrol> view file areas</xref></stentry>
      </strow>
      <strow id="action_stage_all">
        <stentry><uicontrol>Stage All</uicontrol></stentry>
        <stentry>Moves all unstaged files in the current working copy to the
            <uicontrol>Staged files</uicontrol> area. Use this only when all current changes belong
          in the same commit.</stentry>
        <stentry>Stage controls in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
              ><uicontrol>Git Staging</uicontrol> view file areas</xref></stentry>
      </strow>
      <strow id="action_unstage_selected">
        <stentry><uicontrol>Unstage Selected</uicontrol></stentry>
        <stentry>Moves the selected staged files back to the <uicontrol>Unstaged files</uicontrol>
          area without reverting their local changes.</stentry>
        <stentry>Stage controls in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
              ><uicontrol>Git Staging</uicontrol> view file areas</xref></stentry>
      </strow>
      <strow id="action_unstage_all">
        <stentry><uicontrol>Unstage All</uicontrol></stentry>
        <stentry>Moves all staged files back to the <uicontrol>Unstaged files</uicontrol> area
          without removing any local changes.</stentry>
        <stentry>Stage controls in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
              ><uicontrol>Git Staging</uicontrol> view file areas</xref></stentry>
      </strow>
      <strow id="action_discard">
        <stentry><uicontrol>Discard</uicontrol></stentry>
        <stentry>Discards a selected file's unstaged changes and replaces them with the last commit
          version. Does not discard staged changes.</stentry>
        <stentry>Contextual menu of the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
              ><uicontrol>Unstaged files</uicontrol> area</xref></stentry>
      </strow>
      <strow id="action_commit">
        <stentry><uicontrol>Commit</uicontrol></stentry>
        <stentry>Saves the staged changes to the local repository with the message entered in the
            <uicontrol>Commit message</uicontrol> area. See <xref
            href="git-addon-committing.dita#git-addon-committing"/>.</stentry>
        <stentry>
          <ul>
            <li><uicontrol>Commit</uicontrol> button in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_commit_area"
                  ><uicontrol>Git Staging</uicontrol> view commit message area</xref></li>
            <li>Resource-specific <uicontrol>Commit</uicontrol> action in the <xref
                href="git-actions-in-other-views-editors.dita#git-addon-project-view-dita-maps-manager-and-the-current-editor/section_git_contextual_actions_locations"
                  ><uicontrol>Project</uicontrol> view context menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_generate_commit_message_ai">
        <stentry><uicontrol>Generate Commit Message Using AI</uicontrol></stentry>
        <stentry>Uses the <ph keyref="plugin-positron"/> assistant to generate a commit message for the staged changes. Review the
          generated message before committing.</stentry>
        <stentry>Toolbar in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_commit_area"
              ><uicontrol>Git Staging</uicontrol> view commit message area</xref></stentry>
      </strow>
      <strow id="action_choose_previous_comment">
        <stentry><uicontrol>Choose a Previously Used Comment</uicontrol></stentry>
        <stentry>Lets you reuse a previous commit message. Review the reused message to make sure it
          still describes the staged changes in the current commit.</stentry>
        <stentry>Toolbar in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_commit_area"
              ><uicontrol>Git Staging</uicontrol> view commit message area</xref></stentry>
      </strow>
      <strow id="action_auto_push_after_commit">
        <stentry><uicontrol>Automatically Push Changes to Remote Branch</uicontrol></stentry>
        <stentry>Pushes the committed changes to the remote repository after the commit is
          performed. Use this option only when you are ready to publish the commit immediately.</stentry>
        <stentry>Toolbar in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_commit_area"
              ><uicontrol>Git Staging</uicontrol> view commit message area</xref></stentry>
      </strow>
      <strow id="action_amend_last_commit">
        <stentry><uicontrol>Amend Last Commit</uicontrol></stentry>
        <stentry>Combines staged changes with the most recent commit or edits the last commit
          message. Do not amend commits that were already pushed to the remote repository.</stentry>
        <stentry>Toolbar in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_commit_area"
              ><uicontrol>Git Staging</uicontrol> view commit message area</xref></stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
