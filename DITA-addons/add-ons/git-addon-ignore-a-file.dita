<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="git-addon-ignore-a-file">
    <title>Ignore a file</title>
    <taskbody>
        <context>
            <p>To add an untracked file to a project's <codeph>.gitignore</codeph>, on <uicontrol
          conref="uicontrol_terminology.dita#uicontrol_terminology/gs0-git-staging-view"/>, follow
        these steps: </p>
        </context>
        <steps>
            <step>
        <cmd>On <uicontrol
            conref="uicontrol_terminology.dita#uicontrol_terminology/gs1-unstaged-files"/>,
          right-click a file and the contextual menu opens.</cmd>
      </step>
      <step>
        <cmd>From the contextual menu, select <uicontrol
            conref="uicontrol_terminology.dita#uicontrol_terminology/ignore"/>
          <b>></b>
          <uicontrol conref="uicontrol_terminology.dita#uicontrol_terminology/ignore-file"/>.</cmd>
      </step>
        </steps>
    <result id="result_jtf_crv_jjc"><p>The untracked file is added to the end of the project <codeph>.gitignore</codeph> and will no
        longer appear on <uicontrol
          conref="uicontrol_terminology.dita#uicontrol_terminology/gs1-unstaged-files"/>.</p></result>
    <postreq id="postreq_ypp_2tv_jjc">
      <p>To re-enable change tracking of the file,
        <?oxy_comment_start author="adrian_lapadat" timestamp="20260527T114039+0300" comment="add ref to section explaining this"?>remove
        it<?oxy_comment_end?> from the project <codeph>gitignore</codeph>.</p>
    </postreq>
    </taskbody>
</task>
