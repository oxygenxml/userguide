<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="git-addon-comparing-changes-and-conflict-resolution">
  <title>Compare Changes</title>
  
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>comparing changes</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>reviewing changes</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <body>
    <p id="p_gpn_j4y_kpb">To compare your current changes with the latest committed version,
      double-click a file in the <xref
        href="git-addon-unstaged-files-area.dita#git-addon-unstaged-files-area" format="dita"><uicontrol>Unstaged
          files</uicontrol> area</xref> or <xref
        href="git-addon-staged-files-area.dita#git-addon-staged-files-area" format="dita"><uicontrol>Staged
          files</uicontrol> area</xref>. The <uicontrol>Compare Files</uicontrol> window opens and
      highlights the changes.</p>
    <p id="p_hpn_j4y_kpb">Use this comparison before you stage and commit files to check that the
      next commit contains only the intended changes.</p>
  </body>
</topic>