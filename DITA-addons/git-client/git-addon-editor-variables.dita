<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-editor-variables">
  <title>Git Editor Variables</title>
  <shortdesc>The Git Client contributes editor variables you can use wherever <ph keyref="product"/>
    accepts them.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>editor variables</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="1* 2*" frame="all">
      <sthead>
        <stentry>Variable</stentry>
        <stentry>Expands to</stentry>
      </sthead>
      <strow>
        <stentry><codeph>${git(working_copy_name)}</codeph></stentry>
        <stentry>The name of the working copy directory.</stentry>
      </strow>
      <strow>
        <stentry><codeph>${git(working_copy_path)}</codeph></stentry>
        <stentry>The absolute file path of the working copy directory.</stentry>
      </strow>
      <strow>
        <stentry><codeph>${git(working_copy_url)}</codeph></stentry>
        <stentry>The location of the working copy directory as a URL.</stentry>
      </strow>
      <strow>
        <stentry><codeph>${git(short_branch_name)}</codeph></stentry>
        <stentry>The short name of the current branch (for example, <codeph>dev</codeph>).</stentry>
      </strow>
      <strow>
        <stentry><codeph>${git(full_branch_name)}</codeph></stentry>
        <stentry>The full name of the current branch (for example,
            <codeph>refs/heads/dev</codeph>).</stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
