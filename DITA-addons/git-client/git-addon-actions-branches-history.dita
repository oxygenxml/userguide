<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-branches-history">
  <title>Branch, Tag, History, and Blame Actions</title>
  <shortdesc>Actions for working with branches, tags, history, and blame.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>actions<indexterm>branches and history</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 3* 2*" frame="all">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Available from</stentry>
      </sthead>
      <strow id="action_checkout">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-checkout"/></stentry>
        <stentry>Checks out an existing branch, a new branch, or a commit in detached HEAD.</stentry>
        <stentry>History view, Branch Manager</stentry>
      </strow>
      <strow id="action_create_branch">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-create"/></stentry>
        <stentry>Creates a branch from a commit or branch.</stentry>
        <stentry>History view, Branch Manager</stentry>
      </strow>
      <strow id="action_track_remote_branch">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-track-remote"/></stentry>
        <stentry>Sets a local branch to track a remote branch.</stentry>
        <stentry>Branch Manager, Git menu</stentry>
      </strow>
      <strow id="action_merge">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-merge"/></stentry>
        <stentry>Merges the selected branch or commit into the current one.</stentry>
        <stentry>Branch Manager, Git History contextual menu</stentry>
      </strow>
      <strow id="action_squash_merge">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-squash-merge"/></stentry>
        <stentry>Merges the selected branch as a single squashed commit.</stentry>
        <stentry>Branch Manager</stentry>
      </strow>
      <strow id="action_rebase">
        <stentry><uicontrol conkeyref="hist-uicontrols/hist-rebase"/></stentry>
        <stentry>Replays local commits onto the selected commit. Requires a force push afterward.</stentry>
        <stentry>History view contextual menu</stentry>
      </strow>
      <strow id="action_cherry_pick">
        <stentry><uicontrol conkeyref="hist-uicontrols/hist-cherry-pick"/></stentry>
        <stentry>Copies a single commit onto the current branch.</stentry>
        <stentry>History view contextual menu</stentry>
      </strow>
      <strow id="action_revert_commit">
        <stentry><uicontrol conkeyref="hist-uicontrols/hist-revert-commit"/></stentry>
        <stentry>Adds a commit that undoes the selected one. Safe for shared commits.</stentry>
        <stentry>History view contextual menu</stentry>
      </strow>
      <strow id="action_reset_branch_to_commit">
        <stentry><uicontrol conkeyref="hist-uicontrols/hist-reset-to-commit"/></stentry>
        <stentry>Moves the current branch to the selected commit. Use with care.</stentry>
        <stentry>History view contextual menu</stentry>
      </strow>
      <strow id="action_delete_branch">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-delete"/></stentry>
        <stentry>Deletes the selected local branch.</stentry>
        <stentry>Branch Manager, branch label contextual menu</stentry>
      </strow>
      <strow id="action_show_in_history">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-show-in-history"/></stentry>
        <stentry>Shows the selected branch in the History view.</stentry>
        <stentry>Branch Manager</stentry>
      </strow>
      <strow id="action_show_in_branch_manager">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-show-in-manager"/></stentry>
        <stentry>Shows the selected branch in the Branch Manager.</stentry>
        <stentry>History view branch label contextual menu</stentry>
      </strow>
      <strow id="action_go_to_tracking_branch">
        <stentry><uicontrol conkeyref="hist-uicontrols/hist-go-to-tracking-branch"/></stentry>
        <stentry>Selects the tip commit of the local branch's tracking branch.</stentry>
        <stentry>History view local branch label contextual menu</stentry>
      </strow>
      <strow id="action_go_to_local_branch">
        <stentry><uicontrol conkeyref="hist-uicontrols/hist-go-to-local-branch"/></stentry>
        <stentry>Selects the tip commit of a local branch that tracks the selected remote branch.</stentry>
        <stentry>History view remote branch label contextual menu</stentry>
      </strow>
      <strow id="action_create_tag">
        <stentry><uicontrol conkeyref="hist-uicontrols/hist-create-tag"/></stentry>
        <stentry>Creates a tag on the selected commit.</stentry>
        <stentry>History view contextual menu</stentry>
      </strow>
      <strow id="action_show_tags">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-show-tags"/></stentry>
        <stentry>Opens the tags dialog box to check out, push, or delete tags.</stentry>
        <stentry>Git menu, Vertical Ellipsis menu</stentry>
      </strow>
      <strow id="action_explain_commit">
        <stentry><uicontrol conkeyref="hist-uicontrols/hist-explain-commit"/></stentry>
        <stentry>Summarizes one or more commits with <ph keyref="plugin-positron"/>.</stentry>
        <stentry>History view contextual menu</stentry>
      </strow>
      <strow id="action_show_blame">
        <stentry><uicontrol>Show Blame</uicontrol></stentry>
        <stentry>Colors each line of a file by the commit that last changed it.</stentry>
        <stentry>File area, editor, Project view, DITA Maps Manager</stentry>
      </strow>
      <strow id="action_hide_blame">
        <stentry><uicontrol>Hide Blame</uicontrol></stentry>
        <stentry>Turns off blame coloring.</stentry>
        <stentry>Editor, contextual menus</stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
