<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="git-addon-commit-messages-with-ai">
  <title>Write Commit Messages with AI</title>
  <shortdesc>Generate a commit message using AI, reuse a previous one, or amend your last
    commit.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>commit messages</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>AI<indexterm>commit messages</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <taskbody>
    <context>
      <p>The toolbar above the
        <uicontrol conkeyref="gs-uicontrols/gs-commit-message"/>
        area has options that help you write and reuse messages.</p>
    </context>
    <steps>
      <step>
        <cmd>Use any of the commit-message options:</cmd>
        <info>
          <p>
            <dl>
              <dlentry>
                <dt><uicontrol conkeyref="gs-uicontrols/gs-generate-ai"/></dt>
                <dd>Drafts a message from the staged changes, using <ph keyref="plugin-positron"/>.
                  Customize how it writes messages in the <xref href="git-addon-ai-preferences.dita"
                    >AI preferences</xref> page.</dd>
              </dlentry>
              <dlentry>
                <dt><uicontrol conkeyref="gs-uicontrols/gs-previous-comment"/></dt>
                <dd>Reuses a message from a recent commit.</dd>
              </dlentry>
              <dlentry>
                <dt><uicontrol conkeyref="gs-uicontrols/gs-amend"/></dt>
                <dd>Adds the staged changes to your most recent local commit, or edits its
                  message.</dd>
              </dlentry>
              <dlentry>
                <dt><uicontrol conkeyref="gs-uicontrols/gs-auto-push"/></dt>
                <dd>Pushes the commit to the remote immediately after you commit.</dd>
              </dlentry>
            </dl>
          </p>
        </info>
      </step>
    </steps>
    <result>
      <note conkeyref="reuse-lib/reuse-warn-shared-history"/>
    </result>
  </taskbody>
</task>
