<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-configuration">
  <title>Configuration and Preferences Actions</title>
  <shortdesc>Actions for managing remotes, configuration, preferences, and credentials.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>actions<indexterm>configuration</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 3* 2*" frame="all">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Available from</stentry>
      </sthead>
      <strow id="action_manage_remote_repositories">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-manage-remotes"/></stentry>
        <stentry>Adds, renames, edits, or deletes the remotes for the repository.</stentry>
        <stentry>Git menu, Vertical Ellipsis menu</stentry>
      </strow>
      <strow id="action_add_remote">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-add-remote"/></stentry>
        <stentry>Adds a remote to the repository.</stentry>
        <stentry>Git Branch Manager contextual menu (Remote node)</stentry>
      </strow>
      <strow id="action_edit_remote">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-edit-remote"/></stentry>
        <stentry>Changes a remote's name or URL. Renaming preserves the remote's settings, its
          remote-tracking branches, and the tracking of every local branch that followed
          it.</stentry>
        <stentry>Git Branch Manager contextual menu (remote node)</stentry>
      </strow>
      <strow id="action_delete_remote">
        <stentry><uicontrol conkeyref="branch-uicontrols/branch-delete-remote"/></stentry>
        <stentry>Removes a remote and its remote-tracking branches.</stentry>
        <stentry>Git Branch Manager contextual menu (remote node)</stentry>
      </strow>
      <strow id="action_edit_repository_config_file">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-edit-config"/></stentry>
        <stentry>Opens the repository's <filepath>config</filepath> file for editing. Incorrect
          values can affect push, pull, and branch tracking behavior.</stentry>
        <stentry>Git menu, Vertical Ellipsis menu</stentry>
      </strow>
      <strow id="action_preferences">
        <stentry><uicontrol conkeyref="pref-uicontrols/pref-preferences"/></stentry>
        <stentry>Opens the Git Client preferences pages.</stentry>
        <stentry>Git menu, Vertical Ellipsis menu, Options</stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
