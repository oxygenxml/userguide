<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="git-addon-install-store">
  <title>Install from the Add-ons Store</title>
  <shortdesc>Drag an <uicontrol>Install</uicontrol> button into the editor to add the Git Client in
    one step.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>installing</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <taskbody>
    <prereq>
      <p>You must be running <ph keyref="product"/> 26.1 or newer.</p>
    </prereq>
    <steps>
      <step>
        <cmd>Drag the following <uicontrol>Install</uicontrol> button into <ph keyref="product"
          />.</cmd>
        <info>
          <p conkeyref="reusables-addons/p_install_button"/>
          <p><foreign outputclass="html-embed"><![CDATA[
               <a
          title = "Drag and drop into the Oxygen editing area to install (Oxygen 26.1 and newer)."
          href="https://www.oxygenxml.com/InstData/Addons/default/updateSite.xml?oxygenAddonId=com.oxygenxml.git"
          style="padding: 8px; border: 1px solid #cbcbcb; border-radius: 4px; cursor: grab;color:var(--primary-color);
          text-decoration:none;"><img style="vertical-align:middle;" src=" data:image/png;base64,"/><span>Install</span></a>]]></foreign></p>
        </info>
      </step>
      <step>
        <cmd>Confirm the installation and restart <ph keyref="product"/> when prompted.</cmd>
      </step>
    </steps>
  </taskbody>
</task>
