<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="git-staging-uicontrols">
  <title>Git Staging View UI Controls</title>
  <body>
    <p>Reusable UI labels for the Git Staging view. Reference these with
        <codeph>conref</codeph> from any topic that names a control, so each label is written
      once. ID prefix: <codeph>gs-</codeph> (staging), <codeph>conflict-</codeph> (conflict
      resolution).</p>
    <!-- Toolbar -->
    <p><uicontrol id="gs-view"><image href="../img/icons/GitClient16.png" placement="inline"/>Git Staging</uicontrol></p>
    <p><uicontrol id="gs-push"><image href="../img/icons/GitPush16.png" placement="inline"/>Push</uicontrol></p>
    <p><uicontrol id="gs-pull"><image href="../img/icons/GitPullDrop16.png" placement="inline"/>Pull</uicontrol></p>
    <p><uicontrol id="gs-stash"><image href="../img/icons/Stash18.png" placement="inline"/>Stash</uicontrol></p>
    <p><uicontrol id="gs-open-history"><image href="../img/icons/History18.png" placement="inline"/>Show current repository history</uicontrol></p>
    <p><uicontrol id="gs-open-branch-manager"><image href="../img/icons/Branch18.png" placement="inline"/>Show Git Branch Manager view</uicontrol></p>
    <p><uicontrol id="gs-ellipsis"><image href="../img/icons/Ellipsis18.png" placement="inline"/>Vertical Ellipsis</uicontrol></p>
    <!-- Header -->
    <p><uicontrol id="gs-working-copy">Working copy</uicontrol></p>
    <p><uicontrol id="gs-branch">Branch</uicontrol></p>
    <!-- File areas -->
    <p><uicontrol id="gs-unstaged-files">Unstaged files</uicontrol></p>
    <p><uicontrol id="gs-staged-files">Staged files</uicontrol></p>
    <!-- Stage controls -->
    <p><uicontrol id="gs-stage-selected"><image href="../img/icons/StageSelected18.png" placement="inline"/>Stage selected</uicontrol></p>
    <p><uicontrol id="gs-stage-all"><image href="../img/icons/StageAll18.png" placement="inline"/>Stage all</uicontrol></p>
    <p><uicontrol id="gs-unstage-selected"><image href="../img/icons/UnstageSelected18.png" placement="inline"/>Unstage selected</uicontrol></p>
    <p><uicontrol id="gs-unstage-all"><image href="../img/icons/UnstageAll18.png" placement="inline"/>Unstage all</uicontrol></p>
    <p><uicontrol id="gs-toogle-view"><image href="../img/icons/GitToggleView16.png" placement="inline"/>Switch to tree/list view</uicontrol></p>
    <p><uicontrol id="gs-discard">Discard</uicontrol></p>
    <!-- Commit area -->
    <p><uicontrol id="gs-commit-message">Commit message</uicontrol></p>
    <p><uicontrol id="gs-commit">Commit</uicontrol></p>
    <p><uicontrol id="gs-generate-ai"><image href="../img/icons/AI-Git16.png" placement="inline"/>Generate commit message using AI</uicontrol></p>
    <p><uicontrol id="gs-previous-comment"><image href="../img/icons/PreviousCommits16.png"
          id="image_dhd_wzh_xjc"/>Choose a previously used comment</uicontrol></p>
    <p><uicontrol id="gs-amend"><image href="../img/icons/AmendCommit16.png" id="image_m5y_wzh_xjc"
        />Amend last commit</uicontrol></p>
    <p><uicontrol id="gs-auto-push"><image href="../img/icons/AutoPush16.png" id="image_rkv_xzh_xjc"
        />Automatically push changes to remote branch</uicontrol></p>
    <!-- Ignore submenu -->
    <p><uicontrol id="gs-ignore">Ignore</uicontrol></p>
    <p><uicontrol id="gs-ignore-file">Ignore this file</uicontrol></p>
    <p><uicontrol id="gs-ignore-by-extension">Ignore by extension</uicontrol></p>
    <p><uicontrol id="gs-ignore-parent-dir">Ignore parent directory</uicontrol></p>
    <p><uicontrol id="gs-ignore-dir">Ignore this directory</uicontrol></p>
    <p><uicontrol id="gs-ignore-all-files">Ignore all files</uicontrol></p>
    <p><uicontrol id="gs-open-gitignore">Open project .gitignore</uicontrol></p>
    <p><uicontrol id="gs-open-ignore">Open global ignore file</uicontrol></p>
    <!-- Conflict resolution (Unstaged files context menu) -->
    <p><uicontrol id="conflict-resolve">Resolve conflict</uicontrol></p>
    <p><uicontrol id="conflict-open-compare">Open in compare editor</uicontrol></p>
    <p><uicontrol id="conflict-resolve-with-ai"><image href="../img/icons/ExplainCommits18.png"
          placement="inline" id="image_onw_rvg_xjc"/>Resolve with AI</uicontrol></p>
    <p><uicontrol id="conflict-resolve-mine">Resolve Using "Mine"</uicontrol></p>
    <p><uicontrol id="conflict-resolve-theirs">Resolve Using "Theirs"</uicontrol></p>
    <p><uicontrol id="conflict-mark-resolved">Mark Resolved</uicontrol></p>
    <p><uicontrol id="conflict-ai-window">AI Conflict Resolution</uicontrol></p>
    <p><uicontrol id="conflict-ai-analysis">AI analysis</uicontrol></p>
  </body>
</topic>
