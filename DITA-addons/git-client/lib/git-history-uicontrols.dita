<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="git-history-uicontrols">
  <title>Git History View UI Controls</title>
  <body>
    <p>Reusable UI labels for the Git History view. ID prefix: <codeph>hist-</codeph>.</p>
    <p><uicontrol id="hist-view"><image href="../img/icons/History18.png" placement="inline"/>Git History</uicontrol></p>
    <p><uicontrol id="hist-commit-details">Commit Details</uicontrol></p>
    <p><uicontrol id="hist-affected-resources">Affected Resources</uicontrol></p>
    <p><uicontrol id="hist-uncommitted-changes">Uncommitted changes</uicontrol></p>
    <p><uicontrol id="hist-link-with-editor"><image href="../img/icons/LinkEditor16.png"/>Link with
        editor</uicontrol></p>
    <p><uicontrol id="hist-explain-commit"><image href="../img/icons/ExplainCommits18.png" placement="inline"/>Explain commit with AI</uicontrol></p>
    <p><uicontrol id="hist-create-tag">Create Tag</uicontrol></p>
    <p><uicontrol id="hist-cherry-pick">Cherry-Pick</uicontrol></p>
    <p><uicontrol id="hist-revert-commit">Revert Commit</uicontrol></p>
    <p><uicontrol id="hist-reset-to-commit">Reset Branch to Commit</uicontrol></p>
    <p><uicontrol id="hist-rebase">Rebase...</uicontrol></p>
    <p><uicontrol id="hist-go-to-tracking-branch">Go to tracking branch</uicontrol></p>
    <p><uicontrol id="hist-go-to-local-branch">Go to local branch</uicontrol></p>
  </body>
</topic>
