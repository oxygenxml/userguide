<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="git-menu-uicontrols">
  <title>Git Menu and Contextual Action UI Controls</title>
  <body>
    <p>Reusable UI labels for the top-level Git menu and the contextual Git submenu. ID prefix:
        <codeph>menu-</codeph>.</p>
    <p><uicontrol id="menu-git">Git</uicontrol></p>
    <!-- Repository setup -->
    <p><uicontrol id="menu-clone"><image href="../img/icons/Clone16.png" placement="inline"
          id="image_wym_bdh_xjc"/>Clone repository...</uicontrol></p>
    <p><uicontrol id="menu-open"><image href="../img/icons/Browse16.png" id="image_x42_p13_xjc"
        />Open repository...</uicontrol></p>
    <p><uicontrol id="menu-create-in-project">Create repository in project</uicontrol></p>
    <p><uicontrol id="menu-create-here">Create repository here</uicontrol></p>
    <p><uicontrol id="menu-show-working-copy-in">Show working copy in</uicontrol></p>
    <!-- Synchronization -->
    <p><uicontrol id="menu-push"><image href="../img/icons/GitPush16.png" id="image_snz_j13_xjc"
        />Push</uicontrol></p>
    <p><uicontrol id="menu-pull"><image href="../img/icons/GitPull16.png" id="image_hlw_r13_xjc"
        />Pull</uicontrol></p>
    <p><uicontrol id="menu-fetch"><image href="../img/icons/GitFetch16.png" id="image_g4w_313_xjc"
        />Fetch</uicontrol></p>
    <p><uicontrol id="menu-pull-merge">Pull (merge)</uicontrol></p>
    <p><uicontrol id="menu-pull-rebase">Pull (rebase)</uicontrol></p>
    <p><uicontrol id="menu-pull-other">Pull...</uicontrol></p>
    <!-- Views and info -->
    <p><uicontrol id="menu-show-staging"><image href="../img/icons/GitClient16.png" placement="inline"/>Show staging</uicontrol></p>
    <p><uicontrol id="menu-show-branches"><image href="../img/icons/GitBranch16.png"
          id="image_ptq_513_xjc"/>Show branches</uicontrol></p>
    <p><uicontrol id="menu-show-tags"><image href="../img/icons/GitTag16.png" id="image_um5_w13_xjc"
        />Show tags...</uicontrol></p>
    <p><uicontrol id="menu-show-history"><image href="../img/icons/History16.png"
          id="image_r2f_y13_xjc"/>Show history</uicontrol></p>
    <p><uicontrol id="menu-submodule"><image href="../img/icons/GitSubmodule16.png"
          id="image_gdh_z13_xjc"/>Submodules...</uicontrol></p>
    <!-- Stash -->
    <p><uicontrol id="menu-stash-changes"><image href="../img/icons/GitStash16.png"
          id="image_csy_1b3_xjc"/>Stash changes...</uicontrol></p>
    <p><uicontrol id="menu-list-stashes">List stashes...</uicontrol></p>
    <!-- Ignore -->
    <p><uicontrol id="menu-ignore">Ignore</uicontrol></p>
    <!-- Remote and preferences -->
    <p><uicontrol id="menu-manage-remotes"><image href="../img/icons/Remote16.png"
          id="image_asv_cb3_xjc"/>Manage remote repositories...</uicontrol></p>
    <p><uicontrol id="menu-track-remote">Track remote branch...</uicontrol></p>
    <p><uicontrol id="menu-edit-config">Edit repository "config" file</uicontrol></p>
    <p><uicontrol id="menu-preferences"><image href="../img/icons/settings_16.png" placement="inline"/>Preferences</uicontrol></p>
  </body>
</topic>
