<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-ssh-preferences">
  <title>SSH Connections Preferences</title>
  <shortdesc>The options on the <ph keyref="plugin-git-client"/> SSH Connections preferences
    page.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>preferences<indexterm>SSH</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <section id="section_overview">
      <title>Overview</title>
      <p>This page is under the <ph keyref="plugin-git-client"/> preferences page.</p>
      <p>
        <fig>
          <title>SSH Connections Preferences Page</title>
          <image href="img/preferences/ssh_preferences.png" placement="inline"/>
        </fig>
      </p>
    </section>
    <properties>
      <prophead>
        <proptypehd>Option</proptypehd>
        <propvaluehd>Default</propvaluehd>
        <propdeschd>Description</propdeschd>
      </prophead>
      <property>
        <proptype><uicontrol conref="lib/git-preferences-uicontrols.dita#git-preferences-uicontrols/pref-use-ssh-agent"/></proptype>
        <propvalue>Selected</propvalue>
        <propdesc>Authenticates through an SSH agent so keys stored in it are used automatically. On
          Windows, choose <uicontrol>Win32-OpenSSH</uicontrol> (default) or
            <uicontrol>Pageant</uicontrol>. On Linux, macOS, and BSD, the Git Client uses the
          standard Unix domain socket.</propdesc>
      </property>
      <property>
        <proptype><uicontrol>SSH Passphrase</uicontrol></proptype>
        <propvalue>—</propvalue>
        <propdesc>Shows whether an SSH passphrase is currently stored. Select
          <uicontrol>Clear</uicontrol> to remove it, independently of your host credentials.</propdesc>
      </property>
    </properties>
  </refbody>
</reference>
