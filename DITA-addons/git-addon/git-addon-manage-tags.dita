<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="git-addon-manage-tags">
  <title>Create and Manage Tags</title>
  <shortdesc>Tag a commit to mark a release or milestone, then push, check out, or delete your
    tags.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>tags<indexterm>creating</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <taskbody>
    <steps>
      <step>
        <cmd>To create a tag, right-click a commit in the <uicontrol
            conkeyref="hist-uicontrols/hist-view"/> view and
          select <uicontrol
            conkeyref="hist-uicontrols/hist-create-tag"/>. New
          tags are local until you push them.</cmd>
      </step>
      <step>
        <cmd>To manage existing tags, open the
          <uicontrol conkeyref="menu-uicontrols/menu-git"/> menu and
          select
          <uicontrol conkeyref="menu-uicontrols/menu-show-tags"/>.</cmd>
        <info>
          <p>In the <uicontrol>Tags</uicontrol> dialog box, you can check out a tag, push a
            local-only tag to the remote, or delete a tag.</p>
          <p>
            <fig>
              <title>Tags Dialog Box</title>
              <image href="img/dialogs/tags_dialog.png" placement="inline"/>
            </fig>
          </p>
        </info>
      </step>
    </steps>
  </taskbody>
</task>
