<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="git-addon-staged-files-area">
  <title>Stage and Unstage Changes</title>
  
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>staged files</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>commits</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <body>
    <p id="p_qxw_wny_kpb">The <uicontrol>Staged files</uicontrol> area lists the resources that are
      ready to be committed. Stage only the files that belong in the next commit.</p>
    <ul id="ul_staged_files_area">
      <li id="li_unstage_selected">If you decide not to include a staged resource, move it back to
        the <xref href="git-addon-unstaged-files-area.dita#git-addon-unstaged-files-area"
          format="dita"><uicontrol>Unstaged files</uicontrol> area</xref>.</li>
      <li id="li_staged_actions">The <uicontrol>Staged files</uicontrol> area includes actions
        similar to the <uicontrol>Unstaged files</uicontrol> area, except for <xref
          href="git-addon-actions-branches-history.dita#git-addon-actions-branches-history/action_show_history"
            ><uicontrol>Show history</uicontrol></xref> and <xref
          href="git-addon-actions-branches-history.dita#git-addon-actions-branches-history/action_show_blame"
            ><uicontrol>Show blame</uicontrol></xref>.</li>
    </ul>
  </body>
</topic>