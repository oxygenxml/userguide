<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="git-addon-push-commits">
  <title>Push Commits</title>
  <shortdesc>Send your local commits to the remote repository so others can see them.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>pushing</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <taskbody>
    <steps>
      <step>
        <cmd>On the
          <uicontrol conkeyref="gs-uicontrols/gs-view"/>
          toolbar, select
          <uicontrol conkeyref="gs-uicontrols/gs-push"/>.</cmd>
      </step>
    </steps>
    <result>
      <p id="p_ncp_ph2_zjc">The Git Client sends your commits to the remote branch. If the branch
        exists only locally, it creates a matching remote branch.</p>
      <p conkeyref="reuse-lib/reuse-pull-first"/>
      <p>For the full explanation, see <xref href="git-addon-ts-push-rejected-behind.dita"/>.</p>
    </result>
  </taskbody>
</task>
