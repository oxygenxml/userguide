<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-ai-preferences">
  <title>AI Preferences</title>
  <shortdesc>The options available in the <ph keyref="plugin-git-client"/> AI preferences page,
    where you tune how AI features behave.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>preferences<indexterm>AI</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <section id="section_overview">
      <title>Overview</title>
      <note conkeyref="reusables-addons/important_requires_positron"/>
      <p><xref href="git-addon-preferences.dita#git-addon-preferences/section_overview">Open the
          Git Client preferences page</xref>, then select the <uicontrol>AI</uicontrol> page.</p>
      <p>Each AI feature has an
        <uicontrol conkeyref="pref-uicontrols/pref-ai-additional-instructions"/>
        box where you add your own guidance. Save these settings to the project file to share them
        with your team.</p>
      <p>
        <fig>
          <title>AI Preferences Page</title>
          <image href="img/preferences/ai_preferences.png" placement="inline"/>
        </fig>
      </p>
    </section>
    <properties frame="all">
      <prophead>
        <proptypehd>Option</proptypehd>
        <propvaluehd>Default</propvaluehd>
        <propdeschd>Description</propdeschd>
      </prophead>
      <property>
        <proptype><uicontrol conkeyref="pref-uicontrols/pref-ai-commit-message-generation"
          /></proptype>
        <propvalue>-</propvalue>
        <propdesc>Extra instructions for the commit-message generator. They take priority over the
          built-in guidelines. Generation can also draw on the current branch name, recent commit
          messages, and any draft text you have typed.</propdesc>
      </property>
      <property>
        <proptype><uicontrol conkeyref="pref-uicontrols/pref-ai-explain-commits"/></proptype>
        <propvalue>-</propvalue>
        <propdesc>Extra instructions for commit explanations.</propdesc>
      </property>
      <property>
        <proptype><uicontrol conkeyref="pref-uicontrols/pref-ai-conflict-resolution"/></proptype>
        <propvalue>-</propvalue>
        <propdesc>Extra instructions for AI conflict resolution.</propdesc>
      </property>
      <property>
        <proptype><uicontrol conkeyref="pref-uicontrols/pref-ai-context-max-chars"/></proptype>
        <propvalue>2,095,152</propvalue>
        <propdesc>The maximum number of characters sent to the AI as context.</propdesc>
      </property>
      <property>
        <proptype><uicontrol conkeyref="pref-uicontrols/pref-ai-context-commits"/></proptype>
        <propvalue>5</propvalue>
        <propdesc>How many recent commit messages to include as style context (0–50). The AI uses
          them to match your project's commit-message conventions.</propdesc>
      </property>
    </properties>
  </refbody>
</reference>
