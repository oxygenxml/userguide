  <topicgroup id="keys">
    <!-- Add-on download link -->
    <keydef keys="git-client-manual-download"
      href="https://www.oxygenxml.com/php/download-addon.php?updateSite=https://www.oxygenxml.com/InstData/Addons/default/updateSite.xml&amp;oxygenAddonId=com.oxygenxml.git&amp;oxyVersion=27.0"
      format="html" scope="external"/>
    <!-- Add-on name -->
    <keydef keys="plugin-git-client">
      <topicmeta>
        <keywords>
          <keyword>Git Client</keyword>
        </keywords>
      </topicmeta>
    </keydef>
    <!-- product, plugin-positron, and reusables-addons are inherited from the
         parent add-ons.ditamap (the doc set always builds through it); do not
         redefine them here. See ARCHITECTURE.md §3. -->
    <!-- Reuse-library handles for conkeyref. keydef defaults to
         processing-role="resource-only", so these also include the lib topics
         in the map without publishing them (no separate topichead needed).
         See ARCHITECTURE.md §2/§4. -->
    <keydef keys="gs-uicontrols" href="lib/git-staging-uicontrols.dita"/>
    <keydef keys="hist-uicontrols" href="lib/git-history-uicontrols.dita"/>
    <keydef keys="branch-uicontrols" href="lib/git-branch-uicontrols.dita"/>
    <keydef keys="menu-uicontrols" href="lib/git-menu-uicontrols.dita"/>
    <keydef keys="pref-uicontrols" href="lib/git-preferences-uicontrols.dita"/>
    <keydef keys="reuse-lib" href="lib/git-reusables.dita"/>
  </topicgroup>
