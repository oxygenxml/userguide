<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-credentials-preferences">
  <title>Credentials Preferences</title>
  <shortdesc>The stored credentials are shown in the <ph keyref="plugin-git-client"/> Credentials
    preferences page.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>preferences<indexterm>credentials</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <section id="section_overview">
      <title>Overview</title>
      <p>To open the Credentials settings page, go to <menucascade>
          <uicontrol conkeyref="pref-uicontrols/pref-preferences"/>
          <uicontrol conkeyref="pref-uicontrols/pref-plugins"/>
          <uicontrol conkeyref="pref-uicontrols/pref-git-client"/>
          <uicontrol>Credentials</uicontrol>
        </menucascade>, or select <uicontrol conkeyref="menu-uicontrols/menu-settings"/> &gt;
          <uicontrol conkeyref="pref-uicontrols/pref-preferences"/> from the <uicontrol
          conkeyref="menu-uicontrols/menu-git"/> menu. It lists the HTTP and token credentials that
        the Git Client has stored for Git servers.</p>
      <p>
        <fig>
          <title>Credentials Preferences Page</title>
          <image href="img/preferences/credentials_preferences.png" placement="inline"/>
        </fig>
      </p>
    </section>
    <properties>
      <prophead>
        <proptypehd>Column or action</proptypehd>
        <propvaluehd>Default</propvaluehd>
        <propdeschd>Description</propdeschd>
      </prophead>
      <property>
        <proptype><uicontrol>Host</uicontrol></proptype>
        <propvalue>-</propvalue>
        <propdesc>The Git server host for which credentials are stored.</propdesc>
      </property>
      <property>
        <proptype><uicontrol>Type</uicontrol></proptype>
        <propvalue>-</propvalue>
        <propdesc>The stored authentication type, such as <uicontrol>Personal access token</uicontrol>
          or <uicontrol>Basic authentication</uicontrol>.</propdesc>
      </property>
      <property>
        <proptype><uicontrol>Username</uicontrol></proptype>
        <propvalue>-</propvalue>
        <propdesc>The username associated with basic authentication credentials, when available.</propdesc>
      </property>
      <property>
        <proptype><uicontrol>Remove</uicontrol></proptype>
        <propvalue>Disabled until an entry is selected</propvalue>
        <propdesc>Removes the selected stored credentials after you apply the preferences changes. To
          remove credentials for multiple servers, select multiple rows before selecting
            <uicontrol>Remove</uicontrol>.</propdesc>
      </property>
    </properties>
    <section id="section_related_tasks">
      <title>Related task</title>
      <p>For step-by-step instructions, see <xref href="git-addon-manage-credentials.dita"/>.</p>
    </section>
  </refbody>
</reference>
