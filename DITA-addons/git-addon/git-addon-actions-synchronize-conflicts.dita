<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-synchronize-conflicts">
  <title>Synchronization and Conflict Resolution Actions</title>
  <shortdesc>The following table lists actions for synchronizing local and remote changes and
    resolving conflicts.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>synchronization actions</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>conflict resolution actions</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>fetch action</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 4* 3*">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Accessible From</stentry>
      </sthead>
      <strow id="action_push">
        <stentry><uicontrol>Push</uicontrol></stentry>
        <stentry>Sends local commits from the current branch to the remote repository. If the local
          branch does not yet have a corresponding remote branch, the Git Client creates one
          automatically.</stentry>
        <stentry>
          <ul>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_view_toolbar"
                  ><uicontrol>Git Staging</uicontrol> view toolbar</xref></li>
            <li><xref
                href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
                  ><uicontrol>Git History</uicontrol> view</xref> context menu</li>
            <li><xref href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"
                  ><uicontrol>Git Branch Manager</uicontrol> view</xref> context menu</li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_pull">
        <stentry><uicontrol>Pull</uicontrol></stentry>
        <stentry>Opens a submenu with actions for bringing changes from the remote repository into
          the local repository. The pull action you choose from the drop-down menu becomes the
          default action of the toolbar button. See <xref
            href="git-addon-push-pull.dita#git-addon-push-pull"
          />.</stentry>
        <stentry>
          <ul>
            <li><uicontrol>Pull</uicontrol> drop-down menu in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_view_toolbar"
                  ><uicontrol>Git Staging</uicontrol> view toolbar</xref></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_pull_merge">
        <stentry><uicontrol>Pull (Merge)</uicontrol></stentry>
        <stentry>Pulls the latest changes from the remote repository and merges them into the local
          branch. If the same files changed in incompatible ways, Git reports conflicts that must be
          resolved before the merge can finish. See <xref
            href="git-addon-push-pull.dita#git-addon-push-pull"
          />.</stentry>
        <stentry>
          <ul>
            <li><uicontrol>Pull</uicontrol> drop-down menu</li>
            <li><xref
                href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
                  ><uicontrol>Git History</uicontrol> view</xref> context menu</li>
            <li><xref href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"
                  ><uicontrol>Git Branch Manager</uicontrol> view</xref> context menu</li>
            <li><uicontrol>Pull</uicontrol> submenu in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_pull_rebase">
        <stentry><uicontrol>Pull (Rebase)</uicontrol></stentry>
        <stentry>Pulls the latest changes from the remote repository, then reapplies local
          unpublished commits on top of the updated branch to create a linear history. Use rebase
          only when your team workflow allows it for unpublished local commits. See <xref
            href="git-addon-push-pull.dita#git-addon-push-pull"
          />.</stentry>
        <stentry>
          <ul>
            <li><uicontrol>Pull</uicontrol> drop-down menu</li>
            <li><xref
                href="git-addon-showing-the-repository-history.dita#git-addon-showing-the-repository-history"
                  ><uicontrol>Git History</uicontrol> view</xref> context menu</li>
            <li><xref href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"
                  ><uicontrol>Git Branch Manager</uicontrol> view</xref> context menu</li>
            <li><uicontrol>Pull</uicontrol> submenu in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_pull_other_branch">
        <stentry><uicontrol>Pull...</uicontrol></stentry>
        <stentry>Pulls changes from a remote branch other than the one tracked by the current local
          branch. The dialog box lets you choose the remote branch and the pull strategy. See <xref
            href="git-addon-push-pull.dita#git-addon-push-pull"
          />.</stentry>
        <stentry>
          <ul>
            <li><uicontrol>Pull</uicontrol> submenu in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_fetch">
        <stentry><uicontrol>Fetch</uicontrol></stentry>
        <stentry>Downloads the latest commits and remote-tracking references from all configured
          remotes without modifying the working copy or current branch. It updates remote-tracking
          references in the local repository so the <uicontrol>Git History</uicontrol> view and the
            <uicontrol>Git Branch Manager</uicontrol> view reflect the current remote state.</stentry>
        <stentry>
          <ul>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
            <li>Remote branch context menu in the <xref
                href="git-addon-git-branch-manager.dita#git-addon-git-branch-manager"
                  ><uicontrol>Git Branch Manager</uicontrol> view</xref> (right-click
                <uicontrol>Remote Branches</uicontrol> to fetch all remotes, or right-click an
              individual remote to fetch only that remote)</li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_resolve_using_mine">
        <stentry><uicontrol>Resolve Using Mine</uicontrol></stentry>
        <stentry>Resolves a conflicted file by keeping the local version and discarding the incoming
          version for that file.</stentry>
        <stentry>Contextual menu of a conflicted file in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
              ><uicontrol>Unstaged files</uicontrol> area</xref></stentry>
      </strow>
      <strow id="action_resolve_using_theirs">
        <stentry><uicontrol>Resolve Using Theirs</uicontrol></stentry>
        <stentry>Resolves a conflicted file by keeping the incoming version and discarding the local
          version for that file.</stentry>
        <stentry>Contextual menu of a conflicted file in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
              ><uicontrol>Unstaged files</uicontrol> area</xref></stentry>
      </strow>
      <strow id="action_mark_as_resolved">
        <stentry><uicontrol>Mark as Resolved</uicontrol></stentry>
        <stentry>Marks a conflicted file as resolved after you edit the file and choose which
          changes to keep. Use this action only after you check the merged file content.</stentry>
        <stentry>Contextual menu of a conflicted file in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
              ><uicontrol>Unstaged files</uicontrol> area</xref></stentry>
      </strow>
      <strow id="action_resolve_with_ai">
        <stentry><uicontrol>Resolve with AI</uicontrol></stentry>
        <stentry>Uses the <ph keyref="plugin-positron"/> assistant to analyze a conflicted file and propose a resolution. Available
          for conflicted files and requires the <ph keyref="product"/> Positron AI Assistant
          add-on. See <xref
            href="git-addon-ai-assisted-conflict-resolution.dita#git-addon-ai-assisted-conflict-resolution"
          />.</stentry>
        <stentry><uicontrol conref="git-staging-uicontrols.dita#git-staging-uicontrols/git-client-conflicts-resolve-conflict"/> submenu in the context menu of a
          conflicted file in the <xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
              ><uicontrol>Unstaged files</uicontrol> area</xref></stentry>
      </strow>
      <strow id="action_abort_operation">
        <stentry><uicontrol>Abort</uicontrol></stentry>
        <stentry>Stops the current in-progress operation and restores the repository to its state
          before that operation started. This action is available during merge, rebase,
          cherry-pick, and revert conflicts.</stentry>
        <stentry>Conflict resolution controls shown during an in-progress operation</stentry>
      </strow>
      <strow id="action_restart_merge">
        <stentry><uicontrol>Restart Merge</uicontrol></stentry>
        <stentry>Restarts the current merge so you can resolve the conflicts again from the
          beginning.</stentry>
        <stentry>Conflict resolution controls shown during a merge conflict</stentry>
      </strow>
      <strow id="action_continue_rebase">
        <stentry><uicontrol>Continue Rebase</uicontrol></stentry>
        <stentry>Continues the current rebase after conflicts are resolved.</stentry>
        <stentry>Conflict resolution controls shown during a rebase conflict</stentry>
      </strow>

    </simpletable>
  </refbody>
</reference>
