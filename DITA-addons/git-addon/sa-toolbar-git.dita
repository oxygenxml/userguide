<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="sa-toolbar-git">
    <title>git ui on toolbar</title>
    <body>
    <!--TOOLBAR-->
    <!-->Git menu-->
    <p><uicontrol id="sa-toolbar-git">Git</uicontrol></p>
    <!--repository control-->
    <p>Clone repository...</p>
    <p>Open repository...</p>
    <p>Create repository in project</p>
    <p>Show working copy in</p>
    <p>Push</p>
    <p>Pull</p>
    <p>Fetch</p>
    <!--open views and dialog boxes-->
      <p><uicontrol conref="git-toolbar-shared.dita#git-toolbar-shared/sa-toolbar-git-show-staging"
      /></p>
    <p>Show branches</p>
    <p>Show tags...</p>
    <p>Show history</p>
    <p>Submodule</p>
    <!--stash controls-->
    <p>Stash changes...</p>
    <p>List stashes...</p>
    <!--manage remote repos-->
    <p>Manage remote repositories...</p>
    <p>Track remote branch...</p>
    <p>Edit repository "config" file</p>
    <!--settings-->
        <p><uicontrol id="sa-toolbar-git-settings"><image href="img/settings_16.png"/>
        Settings</uicontrol></p>
    <!--APP CONTEXT MENUS-->
    <p><uicontrol id="sa-context-menus-git-"><image href="img/icons/GitClient16.png"/> Git</uicontrol></p>
    </body>
</topic>
