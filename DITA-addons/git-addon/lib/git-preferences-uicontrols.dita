<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="git-preferences-uicontrols">
  <title>Git Client Preferences UI Controls</title>
  <body>
    <p>Reusable UI labels for the Git Client preferences pages. ID prefix: <codeph>pref-</codeph>.</p>
    <p><uicontrol id="pref-options">Options</uicontrol></p>
    <p><uicontrol id="pref-preferences">Preferences</uicontrol></p>
    <p><uicontrol id="pref-plugins">Plugins</uicontrol></p>
    <p><uicontrol id="pref-git-client"><keyword keyref="plugin-git-client"/></uicontrol></p>
    <p><uicontrol id="pref-ssh">SSH Connections</uicontrol></p>
    <p><uicontrol id="pref-ai">AI</uicontrol></p>
    <!-- AI page -->
    <p><uicontrol id="pref-ai-commit-message-generation">Commit Message Generation</uicontrol></p>
    <p><uicontrol id="pref-ai-explain-commits">Explain Commits</uicontrol></p>
    <p><uicontrol id="pref-ai-conflict-resolution">Conflict Resolution</uicontrol></p>
    <p><uicontrol id="pref-ai-additional-instructions">Additional Instructions</uicontrol></p>
    <p><uicontrol id="pref-ai-context">Context</uicontrol></p>
    <p><uicontrol id="pref-ai-context-max-chars">Maximum characters sent to AI</uicontrol></p>
    <p><uicontrol id="pref-ai-context-commits">Recent commits to include for context</uicontrol></p>
    <!-- Global vs project -->
    <p><uicontrol id="pref-global-options">Global Options</uicontrol></p>
    <p><uicontrol id="pref-project-options">Project Options</uicontrol></p>
    <p><uicontrol id="pref-use-ssh-agent">Use SSH Agent</uicontrol></p>
  </body>
</topic>
