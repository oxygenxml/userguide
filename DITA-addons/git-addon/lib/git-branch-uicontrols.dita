<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="git-branch-uicontrols">
  <title>Git Branch Manager UI Controls</title>
  <body>
    <p>Reusable UI labels for the Git Branch Manager view. ID prefix: <codeph>branch-</codeph>.</p>
    <p><uicontrol id="branch-view"><image href="../img/icons/Branch18.png" placement="inline"/>Git Branch Manager</uicontrol></p>
    <p><uicontrol id="branch-local">Local</uicontrol></p>
    <p><uicontrol id="branch-remote">Remote</uicontrol></p>
    <p><uicontrol id="branch-checkout">Checkout</uicontrol></p>
    <p><uicontrol id="branch-create">Create Branch</uicontrol></p>
    <p><uicontrol id="branch-merge">Merge</uicontrol></p>
    <p><uicontrol id="branch-squash-merge">Squash Merge</uicontrol></p>
    <p><uicontrol id="branch-track-remote">Track Remote Branch</uicontrol></p>
    <p><uicontrol id="branch-show-in-history">Show in History</uicontrol></p>
    <p><uicontrol id="branch-show-in-manager">Show in Branch Manager</uicontrol></p>
    <p><uicontrol id="branch-delete">Delete Branch</uicontrol></p>
    <p><uicontrol id="branch-refresh"><image href="../img/icons/Refresh16.png" placement="inline"/>Refresh</uicontrol></p>
    <p><uicontrol id="branch-fetch"><image href="../img/icons/Fetch16.png" placement="inline"/>Fetch</uicontrol></p>
  </body>
</topic>
