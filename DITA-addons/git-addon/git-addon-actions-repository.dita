<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-repository">
  <title>Repository and Working Copy Actions</title>
  <shortdesc>Actions for setting up and opening repositories and working copies.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>actions<indexterm>repository</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 3* 2*" frame="all">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Available from</stentry>
      </sthead>
      <strow id="action_clone_repository">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-clone"/></stentry>
        <stentry>Creates a local copy of a remote repository and sets it as the working copy.</stentry>
        <stentry>Git menu, Vertical Ellipsis menu</stentry>
      </strow>
      <strow id="action_open_repository">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-open"/></stentry>
        <stentry>Opens a repository already on disk as the working copy.</stentry>
        <stentry>Git menu, Working copy drop-down</stentry>
      </strow>
      <strow id="action_create_repository_in_project">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-create-in-project"/></stentry>
        <stentry>Turns the current project folder into a Git repository.</stentry>
        <stentry>Git menu, Vertical Ellipsis menu</stentry>
      </strow>
      <strow id="action_create_repository_here">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-create-here"/></stentry>
        <stentry>Turns a selected folder into a Git repository.</stentry>
        <stentry>Project view contextual menu</stentry>
      </strow>
      <strow id="action_show_working_copy_in">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-show-working-copy-in"/></stentry>
        <stentry>Opens the working copy folder in the system file manager or a terminal.</stentry>
        <stentry>Git menu</stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
