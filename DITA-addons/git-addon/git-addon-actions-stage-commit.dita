<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-stage-commit">
  <title>Review, Compare, Stage, and Commit Actions</title>
  <shortdesc>Actions for reviewing changes, staging them, and committing.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>actions<indexterm>staging and committing</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 3* 2*">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Available from</stentry>
      </sthead>
      <strow id="action_open">
        <stentry><uicontrol>Open</uicontrol></stentry>
        <stentry>Opens the selected file, folder, or submodule.</stentry>
        <stentry>File area context menu</stentry>
      </strow>
      <strow id="action_open_in_compare_editor">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/conflict-open-compare"/></stentry>
        <stentry>Opens the file in the compare editor to show what changed.</stentry>
        <stentry>File area context menu, double-click</stentry>
      </strow>
      <strow id="action_git_diff">
        <stentry><uicontrol>Git Diff</uicontrol></stentry>
        <stentry>Compares the selected resource with its repository version, without going through
          the staging workflow.</stentry>
        <stentry>Project view Git submenu</stentry>
      </strow>
      <strow id="action_stage_selected">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/gs-stage-selected"/></stentry>
        <stentry>Moves the selected files to the staged area.</stentry>
        <stentry>Git Staging view; Git History view uncommitted changes row</stentry>
      </strow>
      <strow id="action_stage_all">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/gs-stage-all"/></stentry>
        <stentry>Moves all changed files to the staged area.</stentry>
        <stentry>Git Staging view</stentry>
      </strow>
      <strow id="action_unstage_selected">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/gs-unstage-selected"/></stentry>
        <stentry>Moves the selected files back to the unstaged area.</stentry>
        <stentry>Git Staging view; Git History view uncommitted changes row</stentry>
      </strow>
      <strow id="action_unstage_all">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/gs-unstage-all"/></stentry>
        <stentry>Moves all staged files back to the unstaged area.</stentry>
        <stentry>Git Staging view</stentry>
      </strow>
      <strow id="action_discard">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/gs-discard"/></stentry>
        <stentry>Reverts the selected files to their last committed state.</stentry>
        <stentry>File area context menu; Git History view uncommitted changes row</stentry>
      </strow>
      <strow id="action_commit">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/gs-commit"/></stentry>
        <stentry>Records the staged changes as a commit in the local repository.</stentry>
        <stentry>Git Staging view</stentry>
      </strow>
      <strow id="action_generate_commit_message_ai">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/gs-generate-ai"/></stentry>
        <stentry>Drafts a commit message from the staged changes, using Positron.</stentry>
        <stentry>Commit message toolbar</stentry>
      </strow>
      <strow id="action_choose_previous_comment">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/gs-previous-comment"/></stentry>
        <stentry>Reuses a message from a recent commit.</stentry>
        <stentry>Commit message toolbar</stentry>
      </strow>
      <strow id="action_amend_last_commit">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/gs-amend"/></stentry>
        <stentry>Adds the staged changes to the most recent local commit, or edits its message.</stentry>
        <stentry>Commit message toolbar</stentry>
      </strow>
      <strow id="action_auto_push_after_commit">
        <stentry><uicontrol conref="lib/git-staging-uicontrols.dita#git-staging-uicontrols/gs-auto-push"/></stentry>
        <stentry>Pushes the commit to the remote immediately after committing.</stentry>
        <stentry>Commit message toolbar</stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
