<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-advanced">
  <title>Advanced Repository Actions</title>
  <shortdesc>Actions for stashes and submodules.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>actions<indexterm>advanced</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 3* 2*">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Available from</stentry>
      </sthead>
      <strow id="action_stash_changes">
        <stentry><uicontrol conref="lib/git-menu-uicontrols.dita#git-menu-uicontrols/menu-stash-changes"/></stentry>
        <stentry>Shelves all uncommitted changes and cleans the working copy.</stentry>
        <stentry>Stash drop-down, Git menu</stentry>
      </strow>
      <strow id="action_stash_selected">
        <stentry><uicontrol>Stash selected files...</uicontrol></stentry>
        <stentry>Shelves only the selected files (both their staged and unstaged changes), reverting
          them to the last committed state. Unavailable when the selection contains conflicts.</stentry>
        <stentry>File area context menu</stentry>
      </strow>
      <strow id="action_list_stashes">
        <stentry><uicontrol conref="lib/git-menu-uicontrols.dita#git-menu-uicontrols/menu-list-stashes"/></stentry>
        <stentry>Opens the stashes dialog box to apply or remove stashes.</stentry>
        <stentry>Stash drop-down, Git menu</stentry>
      </strow>
      <strow id="action_apply_stash">
        <stentry><uicontrol>Apply</uicontrol></stentry>
        <stentry>Restores the selected stash to the working copy.</stentry>
        <stentry>Stashes dialog box</stentry>
      </strow>
      <strow id="action_remove_stash">
        <stentry><uicontrol>Delete</uicontrol> / <uicontrol>Delete all</uicontrol></stentry>
        <stentry>Removes the selected stash, or clears every stash.</stentry>
        <stentry>Stashes dialog box</stentry>
      </strow>
      <strow id="action_submodule">
        <stentry><uicontrol conref="lib/git-menu-uicontrols.dita#git-menu-uicontrols/menu-submodule"/></stentry>
        <stentry>Opens a submodule as the working copy.</stentry>
        <stentry>Git menu, Vertical Ellipsis menu</stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
