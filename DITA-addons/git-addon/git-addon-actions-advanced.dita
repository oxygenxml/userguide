<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-advanced">
  <title>Advanced Repository Actions</title>
  <shortdesc>The following table lists actions for advanced repository workflows, including stashing
    changes and working with submodules.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>advanced actions</indexterm></indexterm>
        <indexterm>Git Client add-on<indexterm>stash actions</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 4* 3*">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Accessible From</stentry>
      </sthead>
      <strow id="action_stash">
        <stentry><uicontrol>Stash</uicontrol></stentry>
        <stentry>Opens a drop-down menu for creating a stash or listing existing stashes. Use a
          stash when you need a clean working copy and want to reapply your changes later. See <xref
            href="git-addon-stashing-files.dita#git-addon-stashing-files"/>.</stentry>
        <stentry><xref
            href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_view_toolbar"
              ><uicontrol>Git Staging</uicontrol> view toolbar</xref></stentry>
      </strow>
      <strow id="action_stash_changes">
        <stentry><uicontrol>Stash Changes</uicontrol></stentry>
        <stentry>Creates a new stash from the changed files in the working copy and removes them
          from the working copy. See <xref
            href="git-addon-stashing-files.dita#git-addon-stashing-files"/>.</stentry>
        <stentry>
          <ul>
            <li><uicontrol>Stash</uicontrol> drop-down menu in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_view_toolbar"
                  ><uicontrol>Git Staging</uicontrol> view toolbar</xref></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_list_stashes">
        <stentry><uicontrol>List Stashes</uicontrol></stentry>
        <stentry>Opens a dialog box that lists existing stashes for the current repository. From
          this list, you can apply a stash or remove one that is no longer needed. See <xref
            href="git-addon-stashing-files.dita#git-addon-stashing-files"/>.</stentry>
        <stentry>
          <ul>
            <li><uicontrol>Stash</uicontrol> drop-down menu in the <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_view_toolbar"
                  ><uicontrol>Git Staging</uicontrol> view toolbar</xref></li>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_apply_stash">
        <stentry><uicontrol>Apply Stash</uicontrol></stentry>
        <stentry>Applies a selected stash to the current working copy. Conflicts can occur if the
          same files changed after the stash was created.</stentry>
        <stentry>Stash list dialog box</stentry>
      </strow>
      <strow id="action_remove_stash">
        <stentry><uicontrol>Remove Stash</uicontrol></stentry>
        <stentry>Deletes a selected stash from the stash list. Remove a stash only when you no
          longer need the saved changes.</stentry>
        <stentry>Stash list dialog box</stentry>
      </strow>
      <strow id="action_submodule">
        <stentry><uicontrol>Submodule</uicontrol></stentry>
        <stentry>Opens a control where you can select a submodule to open and work with. Enabled
          only when the repository contains submodules. See <xref
            href="git-addon-working-with-submodules.dita#git-addon-working-with-submodules"/>.</stentry>
        <stentry>
          <ul>
            <li><xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_ellipsis_menu"
                  ><uicontrol>Vertical Ellipsis</uicontrol> menu</xref></li>
            <li><xref href="git-addon-git-menu.dita#git-addon-git-menu"><uicontrol>Git</uicontrol>
                menu</xref></li>
          </ul>
        </stentry>
      </strow>
      <strow id="action_open_submodule">
        <stentry><uicontrol>Open Submodule</uicontrol></stentry>
        <stentry>Opens the selected submodule so you can work with it as the active repository. See
            <xref href="git-addon-working-with-submodules.dita#git-addon-working-with-submodules"
          />.</stentry>
        <stentry>
          <ul>
            <li><uicontrol>Submodule</uicontrol> control</li>
            <li><uicontrol>Open</uicontrol> context menu action for a modified submodule in the
                <xref
                href="git-addon-git-staging-view-interface.dita#git-addon-git-staging-view-interface/section_git_staging_file_areas"
                  ><uicontrol>Unstaged files</uicontrol> area</xref></li>
          </ul>
        </stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
