<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="git-addon-explain-commit-with-ai">
  <title>Explain a Commit with AI</title>
  <shortdesc>Get a plain-language summary of the changes for one or more commits.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>commits<indexterm>explaining with AI</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <taskbody>
    <context>
      <note conkeyref="reusables-addons/important_requires_positron"/>
    </context>
    <steps>
      <step>
        <cmd>In the
          <uicontrol conkeyref="hist-uicontrols/hist-view"/>
          view, select one or more commits, right-click, and select
          <uicontrol conkeyref="hist-uicontrols/hist-explain-commit"/>.</cmd>
      </step>
    </steps>
    <result>
      <p>The <ph keyref="plugin-positron"/> view opens with a summary of the
        selected commits. Customize how it writes summaries on the
        <xref href="git-addon-ai-preferences.dita">AI preferences</xref> page.</p>
    </result>
  </taskbody>
</task>
