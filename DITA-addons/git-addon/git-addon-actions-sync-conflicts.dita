<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="git-addon-actions-sync-conflicts">
  <title>Synchronization and Conflict Actions</title>
  <shortdesc>Actions for pushing, pulling, fetching, and resolving conflicts.</shortdesc>
  <prolog>
    <metadata>
      <keywords>
        <indexterm>Git Client add-on<indexterm>actions<indexterm>synchronization and conflicts</indexterm></indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
  <refbody>
    <simpletable relcolwidth="2* 3* 2*" frame="all">
      <sthead>
        <stentry>Action</stentry>
        <stentry>Description</stentry>
        <stentry>Available from</stentry>
      </sthead>
      <strow id="action_push">
        <stentry><uicontrol conkeyref="gs-uicontrols/gs-push"/></stentry>
        <stentry>Sends local commits to the remote branch.</stentry>
        <stentry>Git Staging toolbar, Git menu, branch contextual menu, History current-branch
          tip commit</stentry>
      </strow>
      <strow id="action_pull_merge">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-pull-merge"/></stentry>
        <stentry>Pulls remote changes and integrates them with a merge commit.</stentry>
        <stentry>Pull drop-down, Git menu, branch contextual menu, History current-branch tip
          commit</stentry>
      </strow>
      <strow id="action_pull_rebase">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-pull-rebase"/></stentry>
        <stentry>Pulls remote changes and replays local commits on top for a linear history.</stentry>
        <stentry>Pull drop-down, Git menu, branch contextual menu, History current-branch tip
          commit</stentry>
      </strow>
      <strow id="action_pull_other">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-pull-other"/></stentry>
        <stentry>Pulls from a branch other than the tracked one.</stentry>
        <stentry>Pull drop-down, Git menu</stentry>
      </strow>
      <strow id="action_fetch">
        <stentry><uicontrol conkeyref="menu-uicontrols/menu-fetch"/></stentry>
        <stentry>Downloads remote commits and refs without merging.</stentry>
        <stentry>Git menu, Vertical Ellipsis menu, Branch Manager</stentry>
      </strow>
      <strow id="action_resolve_using_mine">
        <stentry><uicontrol conkeyref="gs-uicontrols/conflict-resolve-mine"/></stentry>
        <stentry>Resolves a conflict by keeping your version.</stentry>
        <stentry>Conflict submenu</stentry>
      </strow>
      <strow id="action_resolve_using_theirs">
        <stentry><uicontrol conkeyref="gs-uicontrols/conflict-resolve-theirs"/></stentry>
        <stentry>Resolves a conflict by keeping the incoming version.</stentry>
        <stentry>Conflict submenu</stentry>
      </strow>
      <strow id="action_mark_resolved">
        <stentry><uicontrol conkeyref="gs-uicontrols/conflict-mark-resolved"/></stentry>
        <stentry>Marks a manually edited file as resolved and stages it.</stentry>
        <stentry>Conflict submenu</stentry>
      </strow>
      <strow id="action_resolve_with_ai">
        <stentry><uicontrol conkeyref="gs-uicontrols/conflict-resolve-with-ai"/></stentry>
        <stentry><ph keyref="plugin-positron"/> proposes a resolution for a conflicting file.</stentry>
        <stentry>Conflict submenu</stentry>
      </strow>
      <strow id="action_abort">
        <stentry><uicontrol>Abort</uicontrol></stentry>
        <stentry>Cancels an in-progress operation and restores the prior state.</stentry>
        <stentry>Conflict panel</stentry>
      </strow>
      <strow id="action_restart">
        <stentry><uicontrol>Restart</uicontrol></stentry>
        <stentry>Re-starts an in-progress operation.</stentry>
        <stentry>Conflict panel</stentry>
      </strow>
      <strow id="action_continue">
        <stentry><uicontrol>Continue</uicontrol></stentry>
        <stentry>Completes an in-progress operation once conflicts are resolved.</stentry>
        <stentry>Conflict panel</stentry>
      </strow>
    </simpletable>
  </refbody>
</reference>
