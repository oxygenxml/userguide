<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE map PUBLIC "-//OASIS//DTD DITA Map//EN" "map.dtd" [
<!ENTITY FUSION_MINOR "9.2">
]>
<map id="cf-keydefs">
  <title>Key Definitions</title>
  <!-- product name -->
  <keydef keys="product" product="fusion">
    <topicmeta>
      <keywords>
        <keyword>Oxygen Content Fusion</keyword>
      </keywords>
    </topicmeta>
  </keydef>
  <keydef keys="product" product="fusion-cloud">
    <topicmeta>
      <keywords>
        <keyword>Oxygen Content Fusion</keyword>
      </keywords>
    </topicmeta>
  </keydef>
  <!-- Web Author product name, used by the shared wa-shared topics -->
  <keydef keys="webappProduct">
    <topicmeta>
      <keywords>
        <keyword>Oxygen XML Web Author</keyword>
      </keywords>
    </topicmeta>
  </keydef>
  <!-- CF Enterprise server solution name -->
  <keydef keys="cfEnterprise">
    <topicmeta>
      <keywords>
        <keyword>Oxygen Content Fusion Enterprise Server</keyword>
      </keywords>
    </topicmeta>
  </keydef>
  <!-- CF Public/Cloud server name -->
  <keydef keys="cfPublic">
    <topicmeta>
      <keywords>
        <keyword>Oxygen Content Fusion (Cloud)</keyword>
      </keywords>
    </topicmeta>
  </keydef>
  <!-- product minor version -->
  <keydef keys="minorVersion">
    <topicmeta>
      <keywords>
        <keyword>&FUSION_MINOR;</keyword>
      </keywords>
    </topicmeta>
  </keydef>
  <!-- Local reusable content libraries -->
  <keydef keys="reusables-cf" href="reusables/topics/reusables-cf.dita"/>
  <keydef keys="reusables-cf-wa-waCustom" href="reusables/topics/reusables-cf-wa-waCustom.dita"/>
  <keydef keys="reusables-wa-shared" href="reusables/wa-shared/reusables-wa-shared.dita"/>
  <!-- Frozen, manually-synced local copies of specific entries originally from the main user
    guide's reusables-webapp.dita and reusable-oxygen-shortcuts-list.dita, referenced by the
    shared wa-shared topics (WA-dita-topic-doc-type.dita, making_changes_to_uploaded_files.dita).
    These must remain local to DITA-cf/ and must NOT be changed back to live references into the
    DITA/ project. -->
  <keydef keys="reusables-webapp" href="reusables/wa-shared/reusables-webapp-shared.dita"
    processing-role="resource-only"/>
  <keydef keys="reusable-oxygen-shortcuts-list"
    href="reusables/wa-shared/reusables-oxygen-shortcuts-shared.dita"
    processing-role="resource-only"/>
</map>
