{
  "scope": {
    "glob": "DITA-addons/add-ons/git-addon*.dita",
    "description": "Initial scripted scope for Git add-on style fixes."
  },
  "terminology": {
    "discover_from_ditamaps": true,
    "ditamaps": [
      "DITA-addons/add-ons.ditamap",
      "DITA/reusables/reusables.ditamap"
    ]
  },
  "language_rules": [
    {
      "id": "replace_amount_of_characters",
      "type": "literal_replace",
      "enabled": true,
      "verification": "required",
      "description": "Replace 'amount of characters' with 'number of characters'.",
      "find": "amount of characters",
      "replace": "number of characters"
    },
    {
      "id": "replace_contextual_menu",
      "type": "literal_replace",
      "enabled": true,
      "verification": "required",
      "description": "Prefer 'context menu' over 'contextual menu' in Git add-on docs.",
      "find": "contextual menu",
      "replace": "context menu"
    },
    {
      "id": "replace_contextual_menu_caps",
      "type": "literal_replace",
      "enabled": true,
      "verification": "required",
      "description": "Prefer 'Context Menu' over 'Contextual Menu' in titles and captions.",
      "find": "Contextual Menu",
      "replace": "Context Menu"
    },
    {
      "id": "replace_global_ignore_codeph",
      "type": "regex_replace",
      "enabled": true,
      "verification": "required",
      "description": "Normalize literal code references to the global ignore file when written as codeph ignore.",
      "pattern": "<codeph>ignore</codeph> file",
      "replace": "<codeph>.ignore</codeph> file"
    }
  ],
  "markup_rules": [
    {
      "id": "replace_bold_menu_separator",
      "type": "regex_replace",
      "enabled": true,
      "verification": "required",
      "description": "Replace bold menu separators with semantic menu markup in simple uicontrol pairs.",
      "pattern": "<uicontrol([^>]*)>(.*?)</uicontrol>\\s*<b>>\\s*</b>\\s*<uicontrol([^>]*)>(.*?)</uicontrol>",
      "replace": "<menucascade><uicontrol$1>$2</uicontrol><uicontrol$3>$4</uicontrol></menucascade>"
    },
    {
      "id": "replace_gt_menu_separator",
      "type": "regex_replace",
      "enabled": true,
      "verification": "required",
      "description": "Replace escaped menu separators with semantic menu markup in simple uicontrol pairs.",
      "pattern": "<uicontrol([^>]*)>(.*?)</uicontrol>\\s*&gt;\\s*<uicontrol([^>]*)>(.*?)</uicontrol>",
      "replace": "<menucascade><uicontrol$1>$2</uicontrol><uicontrol$3>$4</uicontrol></menucascade>"
    }
  ],
  "report_only_rules": [
    {
      "id": "resolve_conflict_label",
      "description": "Report occurrences of Resolve conflict or Resolve Conflict for terminology normalization to reusable UI references."
    },
    {
      "id": "heading_case_review",
      "description": "Report targeted heading-case inconsistencies such as 'Create a new branch'."
    },
    {
      "id": "index_keyword_review",
      "description": "Report topics whose index keywords appear incomplete or inconsistent."
    },
    {
      "id": "unresolved_review_comments",
      "description": "Report in-scope files that still contain Oxygen review comments."
    }
  ]
}
