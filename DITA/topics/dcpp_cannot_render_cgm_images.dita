<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE troubleshooting PUBLIC "-//OASIS//DTD DITA Troubleshooting//EN" "troubleshooting.dtd">
<troubleshooting id="dcpp_cannot_render_cgm_images">
    <title>Cannot Render CGM Images</title>
  <prolog>
    <metadata>
      <keywords>
        <indexterm product="author developer editor authorEclipse developerEclipse editorEclipse"
            ><ph keyref="pdf-html5-transformation"/>
          <indexterm>Troubleshooting<indexterm>CGM Images</indexterm></indexterm></indexterm>
        <indexterm product="pdf-css ope">Troubleshooting<indexterm>CGM
          Images</indexterm></indexterm>
      </keywords>
    </metadata>
  </prolog>
    <troublebody>
        <condition id="problem">
      <title>Problem</title>
      <p>When generating PDFs from S1000D data modules, you may encounter errors in the
          <uicontrol>Results</uicontrol> view similar to
        this:<codeblock id="codeblock_hyh_zpx_t3c" outputclass="language-cmd">[CH] Image not available. URI: file:/D:/ICN-S1000DBIKE-AAA-D000000-0-U8025-00502-A-04-1.CGM.
Reason: org.apache.xmlgraphics.image.loader.ImageException: The file format is not supported.
No ImagePreloader found for file:/D:/ICN-S1000DBIKE-AAA-D000000-0-U8025-00502-A-04-1.CGM</codeblock></p>
    </condition>
        <troubleSolution>
            <cause id="cause">
        <title>Cause</title>
        <p>The JCGM libraries required to render these images are not embedded in <b>Oxygen PDF
            Chemistry</b> by default.</p>
      </cause>
            <remedy id="solution">
        <title>Solution</title>
        <steps>
          <step>
            <cmd>Go to the <xref href="https://github.com/SwissAS/jcgm-core/releases" format="html"
                scope="external">jcgm-core</xref> page and download the latest JAR library.</cmd>
          </step>
          <step>
            <cmd>Go to the <xref href="https://github.com/SwissAS/jcgm-image/releases" format="html"
                scope="external">jcgm-image</xref> page and download the latest JAR library.</cmd>
          </step>
          <step>
            <cmd>Copy the downloaded libraries into <filepath product="ope"
                >[OPE_INSTALL_DIR]/plugins/com.oxygenxml.pdf.css/lib/oxygen-pdf-chemistry/lib</filepath><filepath
                product="pdf-css"
                >[DITA_OT_DIR]/plugins/com.oxygenxml.pdf.css/lib/oxygen-pdf-chemistry/lib</filepath>.</cmd>
          </step>
          <step>
            <cmd>Re-run the transformation scenario.</cmd>
          </step>
        </steps>
      </remedy>
        </troubleSolution>
    </troublebody>
</troubleshooting>
