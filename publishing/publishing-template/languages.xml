<languages>
    <!-- 'name' is matched against the 'current.language' parameter.
         'label' is the native name displayed in the selector (defaults to 'name').
         'tooltip' is the selector button tooltip, shown on the pages of this language.
         An optional '{label}' in it is replaced with the label of the language. -->
    <language>
        <name>English</name>
        <label>English</label>
        <folder>d--content-fusion-cloud--wh--en</folder>
        <tooltip>Switch language</tooltip>
    </language>
    <language>
        <name>French</name>
        <label>Français</label>
        <folder>d--content-fusion-cloud--wh--fr</folder>
        <tooltip>Changer la langue</tooltip>
    </language>
</languages>
