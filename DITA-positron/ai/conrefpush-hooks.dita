<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="conrefpush-hooks">
  <title>Hooks Addon Note Push</title>
  <body>
    <!--Conref Push info for Hooks topic-->
    <p conaction="mark"
      conref="../ai/ai_positron_enterprise-hooks.dita#ai_positron_enterprise-hooks/p_hooks_impl_desktop_insert"/>
    <p conaction="pushafter">A ready-to-use implementation is available via the <xref
        href="ai-positron-hooks-addon.dita"><b>Oxygen AI Positron Hooks</b>
        add-on</xref>. It implements this extension point and dispatches hook events to external
      scripts configured in a JSON file, without requiring any Java code. </p>
    <p conaction="mark"
      conref="../ai/ai_positron_enterprise-hooks.dita#ai_positron_enterprise-hooks/p_hooks_ov_inline_desktop_insert"/>
    <simpletable conaction="pushafter" id="st_ov_inline" relcolwidth="2* 1* 3*">
      <sthead>
        <stentry>Event</stentry>
        <stentry>Type</stentry>
        <stentry>Description</stentry>
      </sthead>
      <strow>
        <stentry><codeph>beforeInlineCompletion</codeph></stentry>
        <stentry>Blocking</stentry>
        <stentry>Fired before an inline autocomplete suggestion is requested. Veto to suppress the
          suggestion.</stentry>
      </strow>
      <strow>
        <stentry><codeph>afterInlineCompletion</codeph></stentry>
        <stentry>Fire-and-forget</stentry>
        <stentry>Fired after an inline autocomplete suggestion has been generated.</stentry>
      </strow>
    </simpletable>
    <p conaction="mark"
      conref="../ai/ai_positron_enterprise-hooks.dita#ai_positron_enterprise-hooks/p_hooks_inline_payloads_desktop_insert"/>
    <p conaction="pushafter">
      <dl>
        <dlentry id="dlentry_before_inline_completion">
          <dt><codeph>beforeInlineCompletion</codeph>: Blocking</dt>
          <dd>Fired before an inline autocomplete suggestion is requested from the AI model.
            Throwing an exception suppresses the suggestion — no AI call is made and no ghost text
            is shown.</dd>
          <dd>
            <simpletable id="st_before_inline_completion" relcolwidth="1* 1* 2*">
              <sthead>
                <stentry>Field</stentry>
                <stentry>Type</stentry>
                <stentry>Description</stentry>
              </sthead>
              <strow>
                <stentry><codeph>document_url</codeph></stentry>
                <stentry>string</stentry>
                <stentry>URL of the document open in the editor at the time the suggestion was
                  triggered.</stentry>
              </strow>
              <strow>
                <stentry><codeph>content</codeph></stentry>
                <stentry>string</stentry>
                <stentry>The text context used as input for the suggestion.</stentry>
              </strow>
            </simpletable>
          </dd>
        </dlentry>
        <dlentry id="dlentry_after_inline_completion">
          <dt><codeph>afterInlineCompletion</codeph>: Fire-and-forget</dt>
          <dd>Fired after an inline autocomplete suggestion has been generated by the AI model. Use
            it for auditing, token-usage tracking, or analytics on autocomplete activity. Note that
            this event fires regardless of whether the user accepts or dismisses the ghost
            text.</dd>
          <dd>
            <simpletable id="st_after_inline_completion" relcolwidth="1* 1* 2*">
              <sthead>
                <stentry>Field</stentry>
                <stentry>Type</stentry>
                <stentry>Description</stentry>
              </sthead>
              <strow>
                <stentry><codeph>document_url</codeph></stentry>
                <stentry>string</stentry>
                <stentry>URL of the document for which the suggestion was generated.</stentry>
              </strow>
              <strow>
                <stentry><codeph>suggestion</codeph></stentry>
                <stentry>string</stentry>
                <stentry>The autocomplete suggestion text generated by the AI model. Absent when no
                  suggestion was produced.</stentry>
              </strow>
              <strow>
                <stentry><codeph>tokens_usage</codeph></stentry>
                <stentry>object</stentry>
                <stentry>Token usage for this completion request. Contains
                  <codeph>prompt_tokens</codeph>, <codeph>completion_tokens</codeph>, and
                  <codeph>total_tokens</codeph>. Absent when not reported by the backend.</stentry>
              </strow>
            </simpletable>
          </dd>
        </dlentry>
      </dl>
    </p>
  </body>
</topic>
