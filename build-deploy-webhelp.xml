<project name="deploy-private" default="private">


  <target name="private">
    <fail unless="userguide.server" message="Missing required property: userguide.server"/>
    <property name="userguide.server.dir">/var/www/userguide</property>
    <property name="output.dir">webhelp-responsive-private</property>

  	<echo>Username: ${userguide.server.user}</echo>
  	<echo>Password: ${userguide.server.password}</echo>
    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" failonerror="false"
      command="find ${userguide.server.dir} -maxdepth 1 -mindepth 1 -type d -exec rm -rf '{}' \;" />


    <scp remoteTodir="${userguide.server.user}:${userguide.server.password}@${userguide.server}:${userguide.server.dir}/" trust="yes">
      <fileset dir="${project.build.directory}/output/${output.dir}" />
    </scp>
    
    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" failonerror="false"
      command="mv ${userguide.server.dir}/feedback{,-cloud}" />

  </target>

  <target name="deploy-products">
    <taskdef resource="net/sf/antcontrib/antcontrib.properties"/>
    <fail unless="products" message="Missing required property: products"/>
    <property name="type" value="-public"/>
    <foreach list="${products}" delimiter="," target="deploy-product" param="product"
      inheritall="true"/>
  </target>

  <target name="deploy-product">
    <fail unless="product" message="Missing required property: product"/>
    <property name="type" value="-public"/>
    <property name="auth.type" value="key"/>
    <property name="major.version" value=""/>
    <property name="minor.version" value=""/>
    <property name="micro.version" value="0"/>

    <condition property="deploy.product.public">
      <equals arg1="${type}" arg2="-public"/>
    </condition>
    <condition property="deploy.product.private">
      <equals arg1="${type}" arg2="-private"/>
    </condition>
    <condition property="deploy.auth.key">
      <equals arg1="${auth.type}" arg2="key"/>
    </condition>
    <condition property="deploy.auth.password">
      <equals arg1="${auth.type}" arg2="password"/>
    </condition>

    <fail message="Invalid type '${type}'. Expected '-public' or '-private'.">
      <condition>
        <not>
          <or>
            <isset property="deploy.product.public"/>
            <isset property="deploy.product.private"/>
          </or>
        </not>
      </condition>
    </fail>
    <fail message="Invalid auth.type '${auth.type}'. Expected 'key' or 'password'.">
      <condition>
        <not>
          <or>
            <isset property="deploy.auth.key"/>
            <isset property="deploy.auth.password"/>
          </or>
        </not>
      </condition>
    </fail>

    <antcall target="deploy-product-public" inheritAll="true"/>
    <antcall target="deploy-product-private" inheritAll="true"/>
  </target>

  <target name="deploy-product-public" if="deploy.product.public">
    <fail unless="userguide.server" message="Missing required property: userguide.server"/>
    <property name="userguide.server.user" value=""/>
    <property name="userguide.server.password" value=""/>
    <property name="userguide.server.dir">/repository/userguides</property>
    <property name="output.dir">webhelp-responsive-public</property>

    <available file="${project.build.directory}/output/${output.dir}/${product}" type="dir"
      property="local.product.output.exists"/>
    <fail unless="local.product.output.exists"
      message="Missing local WebHelp output directory: ${project.build.directory}/output/${output.dir}/${product}"/>

    <!-- Local output directory -> public remote directory mapping. -->
    <condition property="remote.product.dir" value="ug-author">
      <equals arg1="${product}" arg2="author-sa"/>
    </condition>
    <condition property="remote.product.dir" value="ug-authorEclipse">
      <equals arg1="${product}" arg2="author-eclipse"/>
    </condition>
    <condition property="remote.product.dir" value="ug-developer">
      <equals arg1="${product}" arg2="developer-sa"/>
    </condition>
    <condition property="remote.product.dir" value="ug-developerEclipse">
      <equals arg1="${product}" arg2="developer-eclipse"/>
    </condition>
    <condition property="remote.product.dir" value="ug-editor">
      <equals arg1="${product}" arg2="editor-sa"/>
    </condition>
    <condition property="remote.product.dir" value="ug-editorEclipse">
      <equals arg1="${product}" arg2="editor-eclipse"/>
    </condition>
    <condition property="remote.product.dir" value="ug-chemistry">
      <equals arg1="${product}" arg2="chemistry"/>
    </condition>
    <condition property="remote.product.dir" value="ug-content-fusion">
      <equals arg1="${product}" arg2="content-fusion"/>
    </condition>
    <condition property="remote.product.dir" value="ug-content-fusion-cloud">
      <equals arg1="${product}" arg2="content-fusion-cloud"/>
    </condition>
    <condition property="remote.product.dir" value="ug-pdf-css">
      <equals arg1="${product}" arg2="pdf-css"/>
    </condition>
    <condition property="remote.product.dir" value="ug-webhelp-responsive">
      <equals arg1="${product}" arg2="webhelp-responsive"/>
    </condition>
    <condition property="remote.product.dir" value="ug-json">
      <equals arg1="${product}" arg2="json"/>
    </condition>
    <condition property="remote.product.dir" value="ug-feedback">
      <equals arg1="${product}" arg2="feedback"/>
    </condition>
    <condition property="remote.product.dir" value="ug-feedback-enterprise">
      <equals arg1="${product}" arg2="feedback-enterprise"/>
    </condition>
    <condition property="remote.product.dir" value="ug-ope">
      <equals arg1="${product}" arg2="ope"/>
    </condition>
    <condition property="remote.product.dir" value="ug-license-server">
      <equals arg1="${product}" arg2="license-server"/>
    </condition>
    <condition property="remote.product.dir" value="ug-webauthor">
      <equals arg1="${product}" arg2="webauthor"/>
    </condition>
    <condition property="remote.product.dir" value="ug-waCustom">
      <equals arg1="${product}" arg2="webauthor-customization"/>
    </condition>
    <condition property="remote.product.dir" value="ug-addons">
      <equals arg1="${product}" arg2="ug-addons"/>
    </condition>
    <condition property="remote.product.dir" value="ug-positron-desktop">
      <equals arg1="${product}" arg2="ug-positron-desktop"/>
    </condition>
    <condition property="remote.product.dir" value="ug-positron-eclipse">
      <equals arg1="${product}" arg2="ug-positron-eclipse"/>
    </condition>
    <condition property="remote.product.dir" value="ug-positron-wa">
      <equals arg1="${product}" arg2="ug-positron-wa"/>
    </condition>
    <condition property="remote.product.dir" value="ug-positron-cf">
      <equals arg1="${product}" arg2="ug-positron-cf"/>
    </condition>

    <fail unless="remote.product.dir"
      message="Unsupported product '${product}'. Add a remote.product.dir mapping in deploy-product-public."/>

    <condition property="remote.base.dir"
      value="${userguide.server.dir}/InstData${major.version}.${minor.version}.${micro.version}"
      else="${userguide.server.dir}/InstData${major.version}.${minor.version}">
      <or>
        <equals arg1="${product}" arg2="webauthor"/>
        <equals arg1="${product}" arg2="webauthor-customization"/>
      </or>
    </condition>

    <echo>Deploy public WebHelp product: ${product}</echo>
    <echo>Local directory: ${project.build.directory}/output/${output.dir}/${product}</echo>
    <echo>Remote directory: ${remote.base.dir}/${remote.product.dir}</echo>

    <antcall target="deploy-product-public-key" inheritAll="true"/>
    <antcall target="deploy-product-public-password" inheritAll="true"/>
  </target>

  <target name="deploy-product-private" if="deploy.product.private">
    <fail unless="userguide.server" message="Missing required property: userguide.server"/>
    <property name="userguide.server.dir">/var/www/userguide</property>
    <property name="output.dir">webhelp-responsive-private</property>

    <available file="${project.build.directory}/output/${output.dir}/${product}" type="dir"
      property="local.product.output.exists"/>
    <fail unless="local.product.output.exists"
      message="Missing local WebHelp output directory: ${project.build.directory}/output/${output.dir}/${product}"/>

    <condition property="remote.product.dir" value="feedback-cloud">
      <equals arg1="${product}" arg2="feedback"/>
    </condition>
    <property name="remote.product.dir" value="${product}"/>

    <echo>Deploy private WebHelp product: ${product}</echo>
    <echo>Local directory: ${project.build.directory}/output/${output.dir}/${product}</echo>
    <echo>Remote directory: ${userguide.server.dir}/${remote.product.dir}</echo>

    <antcall target="deploy-product-private-key" inheritAll="true"/>
    <antcall target="deploy-product-private-password" inheritAll="true"/>
  </target>

  <target name="deploy-product-public-key" if="deploy.auth.key">
    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes"
      failonerror="true" keyfile="${user.home}/.ssh/id_rsa"
      command="mkdir -p ${remote.base.dir}/${remote.product.dir}.uploading &amp;&amp; rm -rf ${remote.base.dir}/${remote.product.dir}.uploading/*"/>

    <scp remoteTodir="${userguide.server.user}@${userguide.server}:${remote.base.dir}/${remote.product.dir}.uploading/"
      trust="yes" keyfile="${user.home}/.ssh/id_rsa">
      <fileset dir="${project.build.directory}/output/${output.dir}/${product}"/>
    </scp>

    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes"
      failonerror="true" keyfile="${user.home}/.ssh/id_rsa"
      command="rm -rf ${remote.base.dir}/${remote.product.dir}.old &amp;&amp; if [ -d ${remote.base.dir}/${remote.product.dir} ]; then mv ${remote.base.dir}/${remote.product.dir} ${remote.base.dir}/${remote.product.dir}.old; fi &amp;&amp; mv ${remote.base.dir}/${remote.product.dir}.uploading ${remote.base.dir}/${remote.product.dir}"/>
  </target>

  <target name="deploy-product-public-password" if="deploy.auth.password">
    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes"
      password="${userguide.server.password}" failonerror="true"
      command="mkdir -p ${remote.base.dir}/${remote.product.dir}.uploading &amp;&amp; rm -rf ${remote.base.dir}/${remote.product.dir}.uploading/*"/>

    <scp remoteTodir="${userguide.server.user}:${userguide.server.password}@${userguide.server}:${remote.base.dir}/${remote.product.dir}.uploading/"
      trust="yes">
      <fileset dir="${project.build.directory}/output/${output.dir}/${product}"/>
    </scp>

    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes"
      password="${userguide.server.password}" failonerror="true"
      command="rm -rf ${remote.base.dir}/${remote.product.dir}.old &amp;&amp; if [ -d ${remote.base.dir}/${remote.product.dir} ]; then mv ${remote.base.dir}/${remote.product.dir} ${remote.base.dir}/${remote.product.dir}.old; fi &amp;&amp; mv ${remote.base.dir}/${remote.product.dir}.uploading ${remote.base.dir}/${remote.product.dir}"/>
  </target>

  <target name="deploy-product-private-key" if="deploy.auth.key">
    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes"
      failonerror="true" keyfile="${user.home}/.ssh/id_rsa"
      command="mkdir -p ${userguide.server.dir}/${remote.product.dir}.uploading &amp;&amp; rm -rf ${userguide.server.dir}/${remote.product.dir}.uploading/*"/>

    <scp remoteTodir="${userguide.server.user}@${userguide.server}:${userguide.server.dir}/${remote.product.dir}.uploading/"
      trust="yes" keyfile="${user.home}/.ssh/id_rsa">
      <fileset dir="${project.build.directory}/output/${output.dir}/${product}"/>
    </scp>

    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes"
      failonerror="true" keyfile="${user.home}/.ssh/id_rsa"
      command="rm -rf ${userguide.server.dir}/${remote.product.dir} &amp;&amp; mv ${userguide.server.dir}/${remote.product.dir}.uploading ${userguide.server.dir}/${remote.product.dir}"/>
  </target>

  <target name="deploy-product-private-password" if="deploy.auth.password">
    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes"
      password="${userguide.server.password}" failonerror="true"
      command="mkdir -p ${userguide.server.dir}/${remote.product.dir}.uploading &amp;&amp; rm -rf ${userguide.server.dir}/${remote.product.dir}.uploading/*"/>

    <scp remoteTodir="${userguide.server.user}:${userguide.server.password}@${userguide.server}:${userguide.server.dir}/${remote.product.dir}.uploading/"
      trust="yes">
      <fileset dir="${project.build.directory}/output/${output.dir}/${product}"/>
    </scp>

    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes"
      password="${userguide.server.password}" failonerror="true"
      command="rm -rf ${userguide.server.dir}/${remote.product.dir} &amp;&amp; mv ${userguide.server.dir}/${remote.product.dir}.uploading ${userguide.server.dir}/${remote.product.dir}"/>
  </target>

  <target name="public">
    <!-- Check for similarities with the private one. -->
  	<fail unless="userguide.server" message="Missing required property: userguide.server"/>
  	<property name="userguide.server.user" value="" />
  	<property name="userguide.server.password" value="" />
    <property name="userguide.server.dir">/repository/userguides</property>
    <property name="output.dir">webhelp-responsive-public</property>
    <property name="major.version" value=""/>
    <property name="minor.version" value=""/>
    <property name="micro.version" value=""/>
  	
  	<condition property="userguide.server.credentials" 
  	  value="${userguide.server.user}:${userguide.server.password}" 
  	  else="${userguide.server.user}">
  	  <isset property="${userguide.server.password}"/>
  	</condition>

  	<echo>Username: ${userguide.server.user}</echo>
  	<echo>Password: ${userguide.server.password}</echo>
  	
  	<!-- Remove old version of userguides -->
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="rm -rf ${userguide.server.dir}/InstData${major.version}.${minor.version}.old" />
  	<!-- Web Author, We bAuthor Customization -->
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="rm -rf ${userguide.server.dir}/InstData${major.version}.${minor.version}.${micro.version}.old" />
  	
  	<!-- Make a backup copy of latest userguides --> 
    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version} ${userguide.server.dir}/InstData${major.version}.${minor.version}.old" />
  	<!-- Web Author, We bAuthor Customization -->
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}.${micro.version} ${userguide.server.dir}/InstData${major.version}.${minor.version}.${micro.version}.old" />

  	<!-- Create directories -->
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mkdir -p ${userguide.server.dir}/InstData${major.version}.${minor.version}" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mkdir -p ${userguide.server.dir}/InstData${major.version}.${minor.version}.${micro.version}" />
  	
	<!-- Copy all userguides to InstData${major.version}.${minor.version} directory -->
    <scp remoteTodir="${userguide.server.user}@${userguide.server}:${userguide.server.dir}/InstData${major.version}.${minor.version}/" 
    	trust="yes" keyfile="${user.home}/.ssh/id_rsa">
      <fileset dir="${project.build.directory}/output/${output.dir}" />
    </scp>
  	
  	<!-- Rename directories -->
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/author-sa ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-author" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/author-eclipse ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-authorEclipse" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/developer-sa ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-developer" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/developer-eclipse ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-developerEclipse" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/editor-sa ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-editor" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/editor-eclipse ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-editorEclipse" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/chemistry ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-chemistry" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/content-fusion ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-content-fusion" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/pdf-css ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-pdf-css" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/webhelp-responsive ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-webhelp-responsive" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/json ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-json" />
    
    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/feedback ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-feedback" />
    <sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/ope ${userguide.server.dir}/InstData${major.version}.${minor.version}/ug-ope" />
  	
  	<!-- Move Web Author, Web Author Customization userguides to ${major.version}.${minor.version}.${micro.version} directory -->
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/webauthor ${userguide.server.dir}/InstData${major.version}.${minor.version}.${micro.version}/ug-webauthor" />
  	<sshexec host="${userguide.server}" username="${userguide.server.user}" trust="yes" password="${userguide.server.password}" 
      failonerror="false" keyfile="${user.home}/.ssh/id_rsa"
      command="mv ${userguide.server.dir}/InstData${major.version}.${minor.version}/webauthor-customization ${userguide.server.dir}/InstData${major.version}.${minor.version}.${micro.version}/ug-waCustom" />
  </target>


</project>
